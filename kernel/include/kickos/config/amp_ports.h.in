// GENERATED by configure_file from kernel/include/kickos/config/amp_ports.h.in; edits to the
// generated copy are overwritten by the next configure.
//
// The AMP partition's port list, as C reads it. ONE list for the whole partition
// (CONFIG_KICKOS_AMP_PORTS), in the order the kernel seats it into root's capability table,
// so an entry's POSITION here is its capability index and nothing may reorder it.

#ifndef KICKOS_CONFIG_AMP_PORTS_H
#define KICKOS_CONFIG_AMP_PORTS_H

// EVERY DEFINE HERE IS #ifndef-GUARDED, so a -D wins where both are seen. The host unit test
// over the window synthesises a partition of its own and compiles the real sources against it;
// no board build defines any of these.
#ifndef KICKOS_AMP_PORT_COUNT
#define KICKOS_AMP_PORT_COUNT @KICKOS_AMP_PORT_COUNT@
#endif

// Which node this image seats for, and the one place a node index becomes a build constant.
// Under one image per node the board states it; under the shared image exactly one core of the
// partition runs a kernel and kmain asserts that it is this one.
#ifndef KICKOS_AMP_SELF_NODE
#define KICKOS_AMP_SELF_NODE @KICKOS_AMP_SELF_NODE@
#endif

// Two initialiser lists, one entry each, in list order. Empty where the count is 0, so every
// user brackets them with the count.
#ifndef KICKOS_AMP_PORT_NODE_LIST
#define KICKOS_AMP_PORT_NODE_LIST @KICKOS_AMP_PORT_NODE_INIT@
#endif
#ifndef KICKOS_AMP_PORT_PORT_LIST
#define KICKOS_AMP_PORT_PORT_LIST @KICKOS_AMP_PORT_PORT_INIT@
#endif

#endif
