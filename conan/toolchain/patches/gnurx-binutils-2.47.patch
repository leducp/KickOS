+  if (!has_rx_sec (dflags))
+  {
+    UNSUPPORTED();
+    return 0;
+  }
+  return 1;
+}
+
+static int
+rx_cr_alt_syntax (unsigned long dflags)
+{
+  return 0 != (dflags & RXDF_cr_alt_syntax);
+}
+
+static int
+rx_valid_crdst (int cr, unsigned long dflags)
+{
+  /* no restriction if asked for the control registers numbers */
+  if (rx_cr_alt_syntax (dflags))
+    return 1;
+
+  const int m = 0xFB031F8D | (has_rx_v2_ext (dflags) ? 0x2000 : 0) |
+                  (has_rx_sec (dflags) ? 0x400C020 : 0);
+  return 0 != ((1 << cr) & m);
+}
+
+static int
+rx_valid_crsrc (int cr, unsigned long dflags)
+{
+  return rx_cr_alt_syntax (dflags) ||
+        (cr == 1) || rx_valid_crdst (cr, dflags);
+}
+
+static int
+rx_valid_trcr (int cr, unsigned long dflags)
+{
+  return (has_rx_sec(dflags)) &&
+        (rx_cr_alt_syntax (dflags) || (0 != ((1 << cr) & 0x300FF20)));
+}
