+// input is original token value (to get a 1:1 mapping with default and alternate syntax)
+static const char *
+rx_get_creg_name (int value)
+{
+  unsigned int i;
+  for (i = 0; i < NUM_TOKENS; i ++)
+    if ((token_table[i].token == CREG) && (token_table[i].val == value))
+      return token_table[i].string;
+  return NULL;
+}
+
+// alternate syntax means that the control register was written in the source using its
+// number (CRnn) instead of its name ('cr0' instead of 'psw', 'cr1' instead of 'pc' etc.)
+static int
+rx_creg_alt_syntax (int value)
+{
+  return value < 0;
+}
+
+// gets the control register number (0-31) from the token value
+static int rx_get_creg_num(int value)
+{
+  return (rx_creg_alt_syntax(value) ? ~value : value) & 31;
+}
+
+// input is original token value, alternate syntax (value < 0) removes restriction
+static int
+rx_valid_creg_dest (int value)
+{
+  return rx_creg_alt_syntax(value) ||
+        ((value < 32) && 0 != (0xFF03FFAD & (1 << value)));
+}
+
+// idem
+static int
+rx_valid_creg_src (int value)
+{
+  return rx_creg_alt_syntax(value) ||
+        ((value == 1) || rx_valid_creg_dest (value));
+}
+
+// idem
+static int
+rx_mvfc_v32_creg (int value)
+{
+  return rx_creg_alt_syntax(value) ||
+        ((value < 32) && 0 != (0x400C020 & (1 << value)));
+}
+
+// idem
+static int
+rx_valid_creg_trmvfc (int value)
+{
+  return rx_creg_alt_syntax(value) ||
+        (value == 32+11 || value == 32+14 || value == 32+15) ||
+        (value < 32 && 0 != (0x3003720 & (1 << value)));
+}
