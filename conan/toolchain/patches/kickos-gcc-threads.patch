+/* SPDX-License-Identifier: GPL-3.0-or-later WITH GCC-exception-3.1
+   Copyright (c) 2026 Philippe Leduc
+   Its declarations follow gthr-posix.h, Copyright (C) 1997-2026 Free Software Foundation, Inc.
+
+   The KickOS threads model, --enable-threads=kickos.  The types fix a layout
+   and nothing more, and the KickOS tree checks its own types against them when
+   it compiles.  Each operation calls the KickOS user runtime's __kickos_gthr_*
+   function of the same name, so what an operation does is the runtime's and
+   changes with it.  Every initialiser is all zero bits.  Only the once may let
+   an exception through.  */
+
+#ifndef GCC_GTHR_KICKOS_H
+#define GCC_GTHR_KICKOS_H
+
+#include <sys/_timespec.h>
+#include <sys/_types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define __GTHREADS 1
+#define __GTHREADS_CXX0X 1
+#define __GTHREAD_HAS_COND 1
+#define __GTHREAD_HAS_COND_CLOCKWAIT 1
+#define __GTHREAD_HAS_MUTEX_CLOCKLOCK 1
+
+/* The KickOS mutex word.  */
+typedef struct
+{
+  __UINT32_TYPE__ __word;
+} __gthread_mutex_t;
+
+/* The mutex word, then the depth its holder has taken it to.  */
+typedef struct
+{
+  __UINT32_TYPE__ __word;
+  __UINT32_TYPE__ __depth;
+} __gthread_recursive_mutex_t;
+
+typedef struct
+{
+  __UINT32_TYPE__ __seq;
+} __gthread_cond_t;
+
+typedef struct
+{
+  __UINT32_TYPE__ __state;
+} __gthread_once_t;
+
+typedef __UINT32_TYPE__ __gthread_key_t;
+
+/* 0 is no thread.  */
+typedef __UINT32_TYPE__ __gthread_t;
+
+typedef struct timespec __gthread_time_t;
+
+#define __GTHREAD_MUTEX_INIT { 0 }
+#define __GTHREAD_MUTEX_INIT_FUNCTION __gthread_mutex_init_function
+#define __GTHREAD_RECURSIVE_MUTEX_INIT { 0, 0 }
+#define __GTHREAD_RECURSIVE_MUTEX_INIT_FUNCTION \
+  __gthread_recursive_mutex_init_function
+#define __GTHREAD_COND_INIT { 0 }
+#define __GTHREAD_COND_INIT_FUNCTION __gthread_cond_init_function
+#define __GTHREAD_ONCE_INIT { 0 }
+#define __GTHREAD_TIME_INIT { 0, 0 }
+
+#define __KICKOS_GTHR_NOTHROW __attribute__ ((__nothrow__))
+
+extern int __kickos_gthr_once (__gthread_once_t *, void (*) (void));
+extern int __kickos_gthr_key_create (__gthread_key_t *, void (*) (void *))
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_key_delete (__gthread_key_t) __KICKOS_GTHR_NOTHROW;
+extern void *__kickos_gthr_getspecific (__gthread_key_t)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_setspecific (__gthread_key_t, const void *)
+  __KICKOS_GTHR_NOTHROW;
+
+extern int __kickos_gthr_mutex_destroy (__gthread_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_mutex_lock (__gthread_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_mutex_trylock (__gthread_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_mutex_timedlock (__gthread_mutex_t *,
+					  const __gthread_time_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_mutex_clocklock (__gthread_mutex_t *, __clockid_t,
+					  const __gthread_time_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_mutex_unlock (__gthread_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+
+extern int __kickos_gthr_recursive_mutex_destroy (__gthread_recursive_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_recursive_mutex_lock (__gthread_recursive_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_recursive_mutex_trylock (__gthread_recursive_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int
+__kickos_gthr_recursive_mutex_timedlock (__gthread_recursive_mutex_t *,
+					 const __gthread_time_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int
+__kickos_gthr_recursive_mutex_clocklock (__gthread_recursive_mutex_t *,
+					 __clockid_t, const __gthread_time_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_recursive_mutex_unlock (__gthread_recursive_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+
+extern int __kickos_gthr_cond_destroy (__gthread_cond_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_cond_broadcast (__gthread_cond_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_cond_signal (__gthread_cond_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_cond_wait (__gthread_cond_t *, __gthread_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_cond_timedwait (__gthread_cond_t *,
+					 __gthread_mutex_t *,
+					 const __gthread_time_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_cond_clockwait (__gthread_cond_t *,
+					 __gthread_mutex_t *, __clockid_t,
+					 const __gthread_time_t *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_cond_wait_recursive (__gthread_cond_t *,
+					      __gthread_recursive_mutex_t *)
+  __KICKOS_GTHR_NOTHROW;
+
+extern int __kickos_gthr_create (__gthread_t *, void *(*) (void *), void *)
+  __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_join (__gthread_t, void **) __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_detach (__gthread_t) __KICKOS_GTHR_NOTHROW;
+extern __gthread_t __kickos_gthr_self (void) __KICKOS_GTHR_NOTHROW;
+extern int __kickos_gthr_yield (void) __KICKOS_GTHR_NOTHROW;
+
+static inline int
+__gthread_active_p (void)
+{
+  return 1;
+}
+
+static inline void
+__gthread_mutex_init_function (__gthread_mutex_t *__mutex)
+{
+  __mutex->__word = 0;
+}
+
+static inline void
+__gthread_recursive_mutex_init_function (__gthread_recursive_mutex_t *__mutex)
+{
+  __mutex->__word = 0;
+  __mutex->__depth = 0;
+}
+
+static inline void
+__gthread_cond_init_function (__gthread_cond_t *__cond)
+{
+  __cond->__seq = 0;
+}
+
+static inline int
+__gthread_equal (__gthread_t __t1, __gthread_t __t2)
+{
+  return __t1 == __t2;
+}
+
+static inline int
+__gthread_once (__gthread_once_t *__once, void (*__func) (void))
+{
+  return __kickos_gthr_once (__once, __func);
+}
+
+static inline int
+__gthread_key_create (__gthread_key_t *__key, void (*__dtor) (void *))
+{
+  return __kickos_gthr_key_create (__key, __dtor);
+}
+
+static inline int
+__gthread_key_delete (__gthread_key_t __key)
+{
+  return __kickos_gthr_key_delete (__key);
+}
+
+static inline void *
+__gthread_getspecific (__gthread_key_t __key)
+{
+  return __kickos_gthr_getspecific (__key);
+}
+
+static inline int
+__gthread_setspecific (__gthread_key_t __key, const void *__ptr)
+{
+  return __kickos_gthr_setspecific (__key, __ptr);
+}
+
+static inline int
+__gthread_mutex_destroy (__gthread_mutex_t *__mutex)
+{
+  return __kickos_gthr_mutex_destroy (__mutex);
+}
+
+static inline int
+__gthread_mutex_lock (__gthread_mutex_t *__mutex)
+{
+  return __kickos_gthr_mutex_lock (__mutex);
+}
+
+static inline int
+__gthread_mutex_trylock (__gthread_mutex_t *__mutex)
+{
+  return __kickos_gthr_mutex_trylock (__mutex);
+}
+
+static inline int
+__gthread_mutex_timedlock (__gthread_mutex_t *__mutex,
+			   const __gthread_time_t *__abs_timeout)
+{
+  return __kickos_gthr_mutex_timedlock (__mutex, __abs_timeout);
+}
+
+static inline int
+__gthread_mutex_clocklock (__gthread_mutex_t *__mutex, __clockid_t __clockid,
+			   const __gthread_time_t *__abs_timeout)
+{
+  return __kickos_gthr_mutex_clocklock (__mutex, __clockid, __abs_timeout);
+}
+
+static inline int
+__gthread_mutex_unlock (__gthread_mutex_t *__mutex)
+{
+  return __kickos_gthr_mutex_unlock (__mutex);
+}
+
+static inline int
+__gthread_recursive_mutex_destroy (__gthread_recursive_mutex_t *__mutex)
+{
+  return __kickos_gthr_recursive_mutex_destroy (__mutex);
+}
+
+static inline int
+__gthread_recursive_mutex_lock (__gthread_recursive_mutex_t *__mutex)
+{
+  return __kickos_gthr_recursive_mutex_lock (__mutex);
+}
+
+static inline int
+__gthread_recursive_mutex_trylock (__gthread_recursive_mutex_t *__mutex)
+{
+  return __kickos_gthr_recursive_mutex_trylock (__mutex);
+}
+
+static inline int
+__gthread_recursive_mutex_timedlock (__gthread_recursive_mutex_t *__mutex,
+				     const __gthread_time_t *__abs_timeout)
+{
+  return __kickos_gthr_recursive_mutex_timedlock (__mutex, __abs_timeout);
+}
+
+static inline int
+__gthread_recursive_mutex_clocklock (__gthread_recursive_mutex_t *__mutex,
+				     __clockid_t __clockid,
+				     const __gthread_time_t *__abs_timeout)
+{
+  return __kickos_gthr_recursive_mutex_clocklock (__mutex, __clockid,
+						  __abs_timeout);
+}
+
+static inline int
+__gthread_recursive_mutex_unlock (__gthread_recursive_mutex_t *__mutex)
+{
+  return __kickos_gthr_recursive_mutex_unlock (__mutex);
+}
+
+static inline int
+__gthread_cond_destroy (__gthread_cond_t *__cond)
+{
+  return __kickos_gthr_cond_destroy (__cond);
+}
+
+static inline int
+__gthread_cond_broadcast (__gthread_cond_t *__cond)
+{
+  return __kickos_gthr_cond_broadcast (__cond);
+}
+
+static inline int
+__gthread_cond_signal (__gthread_cond_t *__cond)
+{
+  return __kickos_gthr_cond_signal (__cond);
+}
+
+static inline int
+__gthread_cond_wait (__gthread_cond_t *__cond, __gthread_mutex_t *__mutex)
+{
+  return __kickos_gthr_cond_wait (__cond, __mutex);
+}
+
+static inline int
+__gthread_cond_timedwait (__gthread_cond_t *__cond, __gthread_mutex_t *__mutex,
+			  const __gthread_time_t *__abs_timeout)
+{
+  return __kickos_gthr_cond_timedwait (__cond, __mutex, __abs_timeout);
+}
+
+static inline int
+__gthread_cond_clockwait (__gthread_cond_t *__cond, __gthread_mutex_t *__mutex,
+			  __clockid_t __clockid,
+			  const __gthread_time_t *__abs_timeout)
+{
+  return __kickos_gthr_cond_clockwait (__cond, __mutex, __clockid,
+				       __abs_timeout);
+}
+
+static inline int
+__gthread_cond_wait_recursive (__gthread_cond_t *__cond,
+			       __gthread_recursive_mutex_t *__mutex)
+{
+  return __kickos_gthr_cond_wait_recursive (__cond, __mutex);
+}
+
+static inline int
+__gthread_create (__gthread_t *__threadid, void *(*__func) (void *),
+		  void *__args)
+{
+  return __kickos_gthr_create (__threadid, __func, __args);
+}
+
+static inline int
+__gthread_join (__gthread_t __threadid, void **__value_ptr)
+{
+  return __kickos_gthr_join (__threadid, __value_ptr);
+}
+
+static inline int
+__gthread_detach (__gthread_t __threadid)
+{
+  return __kickos_gthr_detach (__threadid);
+}
+
+static inline __gthread_t
+__gthread_self (void)
+{
+  return __kickos_gthr_self ();
+}
+
+static inline int
+__gthread_yield (void)
+{
+  return __kickos_gthr_yield ();
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ! GCC_GTHR_KICKOS_H */
