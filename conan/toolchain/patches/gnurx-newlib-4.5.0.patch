@@ -8,25 +8,22 @@
 	;; R1: string pointer
 	;; R2: byte sought
 	;; R3: max number to scan
-#ifdef __RX_DISALLOW_STRING_INSNS__
-	mov.b	r2, r2		; The mov.b below sign extends as it loads, so make sure that r2 is sign-extended as well.
-2:	cmp	#0, r3
