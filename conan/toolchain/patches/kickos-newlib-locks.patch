-/* Walkable file locking routine.  */
-static int
-__fp_lock (struct _reent * ptr __unused, FILE * fp)
+/* KickOS: sfp, then every FILE slot, free ones included, so no FILE opens,
+   closes or reopens until __fp_unlock_all.  Each slot's lock is tried with
+   sfp held, since its holder may be waiting for sfp (fclose, a failing
+   freopen): on one held elsewhere the walk lets go of everything, waits for
+   that one alone and starts again.  */
+static FILE *
+__fp_trylock_slots (void)
 {
-  if (!(fp->_flags2 & __SNLK))
-    _flockfile (fp);
+  struct _glue *g;
+  FILE *fp;
+  int n;
 
-  return 0;
+  for (g = &__sglue; g != NULL; g = g->_next)
+    {
+      for (fp = g->_iobs, n = g->_niobs; --n >= 0; fp++)
+	{
+	  if (not __lock_try_acquire_recursive (&fp->_lock))
+	    {
+	      return fp;
+	    }
+	}
+    }
+  return NULL;
 }
 
-/* Walkable file unlocking routine.  */
-static int
-__fp_unlock (struct _reent * ptr __unused, FILE * fp)
+/* Every slot's lock before `upto', every slot's for NULL.  */
+static void
+__fp_unlock_slots (FILE *upto)
 {
-  if (!(fp->_flags2 & __SNLK))
-    _funlockfile (fp);
+  struct _glue *g;
+  FILE *fp;
+  int n;
 
-  return 0;
+  for (g = &__sglue; g != NULL; g = g->_next)
+    {
+      for (fp = g->_iobs, n = g->_niobs; --n >= 0; fp++)
+	{
+	  if (fp == upto)
+	    {
+	      return;
+	    }
+	  __lock_release_recursive (&fp->_lock);
+	}
+    }
 }
 
 void
 __fp_lock_all (void)
 {
-  __sfp_lock_acquire ();
-  (void) _fwalk_sglue (NULL, __fp_lock, &__sglue);
+  FILE *busy;
+
+  while (true)
+    {
+      __sfp_lock_acquire ();
+      busy = __fp_trylock_slots ();
+      if (busy == NULL)
+	{
+	  return;
+	}
+      __fp_unlock_slots (busy);
+      __sfp_lock_release ();
+      __lock_acquire_recursive (&busy->_lock);
+      __lock_release_recursive (&busy->_lock);
+    }
 }
 
 void
 __fp_unlock_all (void)
 {
-  (void) _fwalk_sglue (NULL, __fp_unlock, &__sglue);
+  __fp_unlock_slots (NULL);
   __sfp_lock_release ();
 }
