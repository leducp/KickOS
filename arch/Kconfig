#
# Arch and chip declarations. A chip stanza is pure `select`: it states which
# capabilities the silicon has, and decides no knob's value, so a new chip adds a
# stanza and edits no ladder.
#
# Everything here is unprompted. A chip CONSTANT belongs in platform/<chip>/chip.yaml, from
# which configure generates kickos/chip_limits.h: an option whose availability and default
# depend on no hardware fact is not configuration.

config ARCH_HAS_KERNEL_STACKS
	bool
	help
	  The arch's trap entry can transfer to a per-thread kernel stack, and its
	  arch_context carries the kernel_sp that entry loads. NECESSARY AND NOT
	  SUFFICIENT: whether a given board actually carves the blocks is
	  KICKOS_KERNEL_STACKS, which asks this AND the chip's HAS_MPU.

config ARCH_KERNEL_STACKS_MANDATORY
	bool
	help
	  The arch's switch.S compiles the transfer UNCONDITIONALLY, with no red-zone path
	  beside it, and its backend static_asserts KICKOS_KERNEL_STACKS != 0. Selecting
	  this makes that knob default 1 unconditionally on the arch, so no chip capability
	  or board opt-in can steer it to a value those backends reject, and pins it with
	  `range 1 1` as a declared invariant. A requested 0 is REFUSED BY NAME at configure
	  instead of reaching the assert as a compile error.

	  WHY IT IS NOT IMPLIED BY ARCH_HAS_KERNEL_STACKS. That symbol says the entry CAN
	  transfer; this one says it can do nothing else. armv6m, armv8a, rxv3, rv32imac,
	  rv64imac and x86_64 select this: every chip on them either has an MPU or opted in,
	  so the fallback was never written and their asserts have always been the only
	  thing standing behind the knob's `default 0`.

	  ARMV7M DELIBERATELY DOES NOT SELECT IT, and that is what makes the distinction
	  expressible rather than a tautology. It carries BOTH paths under
	  KICKOS_KERNEL_STACKS because stm32f302 and sam3x8e have no MPU and did not opt in:
	  on a chip with no privilege boundary the transfer buys robustness rather than
	  isolation, and the red zone buys the same robustness without KICKOS_THREAD_SLOTS
	  blocks of kernel .bss. f302nucleo and due are those boards, and they must keep
	  resolving 0.

	  A NEW ARCH THAT WRITES ONLY THE TRANSFER SELECTS THIS. One that writes both paths
	  does not, and then the red zone is what its unconverted boards depend on.

config ARCH_HAS_TLS
	bool
	help
	  The arch has a per-thread thread pointer reachable from UNPRIVILEGED code:
	  a register the kernel writes at restore (rv32imac tp, lx6 THREADPTR), or a
	  leaf the kernel provides that derives it from SP (armv7m, armv6m
	  __aeabi_read_tp; rxv3 through its emutls anchor).

	  ARCH_SIM DOES NOT SELECT IT, and cannot. Its threads are ucontext coroutines
	  in ONE host thread sharing one %fs, and instance_local.h already owns host
	  TLS deliberately for the signal handlers. An fs-base swap was probed and
	  segfaults. So the arch with the largest test suite cannot witness this
	  feature at all, and that is stated here rather than left to be discovered.

config ARCH_TLS_FROM_SP
	bool
	help
	  The unprivileged thread pointer is the STACK POINTER masked down to
	  KICKOS_TLS_STRIDE, so the stride is a real constraint on every stack block:
	  power-of-two size, natural alignment, and one stride exactly.

	  armv6m and armv7m have no choice, the M profile offering no per-thread register
	  to unprivileged code. rxv3 has none either: its emutls anchor runs unprivileged
	  and SP is the only register that differs per thread there.

	  ARMV8A, LX6 AND RV32IMAC DO NOT SELECT IT. Each seats its register (TPIDR_EL0,
	  THREADPTR, tp) from the context at every switch-in, and the context derives that
	  value from the block by SUBTRACTION, so the stack's low bound owes no alignment
	  past the ABI's sixteen bytes and a caller may hand in a stack of any size at any
	  such boundary.

	  ARCH_SIM does not select it and cannot: it does not select ARCH_HAS_TLS either.

config ARCH_HAS_IPC_FASTPATH
	bool
	help
	  The arch completes a register-form IPC call inside its trap handler: switch.S
	  branches to the leaf from the syscall trap and the backend's
	  arch_ctx_set_syscall_result writes the saved frame, so the exception return lands in
	  the server. The leaf holds no lock object, only the local interrupt mask the trap
	  took, which is exclusion on one core and nothing on another, so one kernel across
	  cores is not offered beside it (docs/design-multicore.md section 4 gap 1).

config KICKOS_ARCH_HAS_IPC_FASTPATH
	int
	default 1 if ARCH_HAS_IPC_FASTPATH
	default 0

# The six properties one kernel image across cores requires, which KICKOS_MULTICORE_SHARED
# depends on. An ARCH stanza selects the first three, which the ISA gives every part it defines,
# and a CHIP stanza the last three, which are the part's: an arch selecting a part's property
# certifies it for parts nobody has seen, and a chip selecting the ISA's satisfies it for itself
# alone (tools/kconfig/test_genconfig.py holds each to its owner). The launch is not one of the
# six: two parts of one arch that meet all six can still release a secondary differently.

config ARCH_SMP_COHERENT
	bool
	help
	  Coherent shared memory, with no software maintenance for shared kernel state.

config ARCH_SMP_EXCLUSION
	bool
	help
	  An inter-core exclusion primitive the kernel lock takes its word with.

config ARCH_SMP_IDENTITY
	bool
	help
	  A per-core identity arch_cpu_id reads.

config CHIP_SMP_INTERRUPT
	bool
	help
	  An inter-core interrupt.

config CHIP_SMP_SYMMETRIC
	bool
	help
	  Cores a thread runs the same on, whichever it lands on.

config CHIP_SMP_TARGETING
	bool
	help
	  Per-line interrupt targeting, so a line is pinned to a core rather than masked on the
	  cores that must not take it.

config ARCH_HAS_FAULT_ISOLATION
	bool
	help
	  The arch ships arch_fault_is_user_thread and arch_fault_redirect_to_exit, so where the
	  chip has a privilege ring a fault in an unprivileged thread ends that thread's task
	  rather than the kernel.

config KICKOS_ARCH_FAULT_ISOLATION
	int
	default 1 if ARCH_HAS_FAULT_ISOLATION
	default 0

config CHIP_AMP_CONSOLE_CLAIM
	bool
	help
	  The chip's own-image AMP nodes write one console UART polled, each under a
	  partition-shared claim, and arm no ring.

config KICKOS_AMP_CONSOLE_CLAIM
	int
	default 1 if CHIP_AMP_CONSOLE_CLAIM && KICKOS_AMP_POSTURE_OWN_IMAGE
	default 0

config ARCH_ARMV6M
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY
	select ARCH_HAS_IPC_FASTPATH

config ARCH_ARMV7M
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_HAS_IPC_FASTPATH

# The kernel-stack pair is mandatory: a trap from EL0 selects SP_EL1, and the entry has no
# red-zone path beside the transfer.
#
# Coherent: the architecture defines the inner-shareable domain and the shareability attribute
# that places Normal memory in it. A CHIP OWES SH=0b11 ON ITS NORMAL BOOT DESCRIPTORS for that to
# hold, which the boot tables in each chip's startup.S and aspace_armv8a.cc program; a chip
# mapping kernel state non-shareable breaks this silently. Exclusion: LDXR/STXR over that domain,
# architectural rather than an integration option. Identity: MPIDR_EL1.
config ARCH_ARMV8A
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_TLS
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY
	select ARCH_SMP_COHERENT
	select ARCH_SMP_EXCLUSION
	select ARCH_SMP_IDENTITY

config ARCH_RXV3
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY
	select ARCH_HAS_IPC_FASTPATH

config ARCH_RV32IMAC
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_TLS
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY
	select ARCH_HAS_IPC_FASTPATH

# The kernel-stack pair is mandatory: the entry loads the block from sscratch before it
# stores anything. A translating chip matches no `default 1` on KICKOS_KERNEL_STACKS, so
# without this the knob resolves 0 and the backend fails to compile.
#
# Coherent: RVWMO is one coherent memory over every hart and this port programs no cacheability
# distinction, so no maintenance is owed. Exclusion: LR/SC (Zalrsc in this port's baseline).
# Identity: a dense index published in sscratch at bring-up (rv64imac/percpu.h), NOT mhartid,
# which is integrator-chosen.
config ARCH_RV64IMAC
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY
	select ARCH_SMP_COHERENT
	select ARCH_SMP_EXCLUSION
	select ARCH_SMP_IDENTITY

# Coherent: the ISA defines no coherency protocol and no maintenance for a memory no cache sits
# on, so shared kernel state there is coherent by absence. A CHIP OWES THAT PLACEMENT AS A
# LINK-TIME REFUSAL: one letting kernel state land behind a cache breaks this silently. Ordering
# is the Multiprocessor Synchronization Option's L32AI/S32RI (ISA summary 4.3.12, p.115).
# Exclusion: S32C1I against SCOMPARE1 (Conditional Store Option, 4.3.13), acquire and release on
# its own (4.3.13.5, p.122), so the claim needs no barrier and the release does. ATOMCTL, SR 99,
# DECIDES WHETHER IT REACHES THE BUS AT ALL (4.3.13.4, Table 52, p.121): its local arm excludes a
# core from itself and from nobody else. Identity: PRID, SR 235 (6.4, p.255), loaded from pins
# and only TYPICALLY 0..NPROCESSORS-1, so the dense index is a per-part mapping that refuses a
# value it does not know.
config ARCH_LX6
	bool
	select ARCH_HAS_TLS
	select ARCH_SMP_COHERENT
	select ARCH_SMP_EXCLUSION
	select ARCH_SMP_IDENTITY

# The kernel-stack pair is mandatory: SYSCALL loads NO stack pointer (AMD APM Vol 2 6.1.1),
# so no hardware stack exists for a red-zone path to fall back on.
config ARCH_X86_64
	bool
	select ARCH_HAS_FAULT_ISOLATION
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY
	select ARCH_SMP_COHERENT
	select ARCH_SMP_EXCLUSION
	select ARCH_SMP_IDENTITY

config ARCH_SIM
	bool
	select ARCH_HAS_FAULT_ISOLATION

# kos_clock_now reads the counter the kernel's clock reads, in user mode with no kernel entry.
# Every core opens that read to user mode at bring-up.
config KICKOS_CLOCK_USER
	bool
	default y if ARCH_ARMV8A || ARCH_RV64IMAC || ARCH_X86_64 || ARCH_SIM

config KICKOS_ARCH
	string
	default "armv6m" if ARCH_ARMV6M
	default "armv7m" if ARCH_ARMV7M
	default "armv8a" if ARCH_ARMV8A
	default "rxv3" if ARCH_RXV3
	default "rv32imac" if ARCH_RV32IMAC
	default "rv64imac" if ARCH_RV64IMAC
	default "lx6" if ARCH_LX6
	default "x86_64" if ARCH_X86_64
	default "sim" if ARCH_SIM

# The SESSION record's arch id, a wire value: enum ArchId (include/kickos/trace/record.h), which
# each arch backend static_asserts against this.
config KICKOS_TRACE_ARCH
	int
	default 1 if ARCH_ARMV7M
	default 2 if ARCH_ARMV6M
	default 3 if ARCH_LX6
	default 4 if ARCH_RXV3
	default 5 if ARCH_RV32IMAC
	default 0

# Positive identification: a new arch lands in the 0 branch of every `#if KICKOS_ARCH_SIM`.
config KICKOS_ARCH_SIM
	int
	default 1 if ARCH_SIM
	default 0

# PE32+ holds no undefined symbol, so an image there may not lean on a weak undefined reference
# resolving to zero.
config KICKOS_LINKER_WEAK_UNDEF
	int
	default 0 if ARCH_X86_64
	default 1

config KICKOS_LIBC_REENT
	int
	default 0 if ARCH_SIM
	default 1

# Where libc asks __getreent the thread pointer answers it: lx6 above one kernel core, and every
# armv8a, rv64imac and x86_64 image, whose newlib the KickOS toolchain builds dynamic-reent.
# Elsewhere one word is seated at every switch, which is correct only while one core runs its
# readers.
config KICKOS_REENT_PER_THREAD
	int
	default 1 if ARCH_RV64IMAC || ARCH_X86_64 || ARCH_ARMV8A
	default 1 if ARCH_LX6 && KICKOS_KERNEL_CORES > 1
	default 0

# The reentrant state is the first word of the thread's TLS control block, so KICKOS_TLS must
# carve it (CMakeLists.txt refuses KICKOS_TLS=n here).
config KICKOS_REENT_IN_TCB
	int
	default 1 if ARCH_ARMV8A
	default 1 if ARCH_LX6 && KICKOS_KERNEL_CORES > 1
	default 0

config KICKOS_ARCH_FAMILY
	string
	default "arm" if ARCH_ARMV6M || ARCH_ARMV7M
	default "arm64" if ARCH_ARMV8A
	default "rx" if ARCH_RXV3
	default "riscv" if ARCH_RV32IMAC || ARCH_RV64IMAC
	default "xtensa" if ARCH_LX6
	default "x86" if ARCH_X86_64
	default "sim" if ARCH_SIM

