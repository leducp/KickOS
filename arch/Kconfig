config CHIP_XMC4800
	bool
	select ARCH_ARMV7M
	select HAS_MPU

# Interrupt: four GLOBAL single-bit triggers, DPORT_CPU_INTR_FROM_CPU_0..3_REG at 0x3FF000DC + 4n,
# bit 0, R/W, reset 0 (TRM v5.8 Register 12.24, p.258), raised as matrix sources 24..27 (Table
# 8.3-1, p.176). One bit is one source, not per target core, and each CPU's matrix bank routes it
# independently. The register is plain R/W where a self-clearing bit reads R/W/SC and no prose
# states a hardware clear, so the receiver clears by writing it and a set racing that write is a
# real lost edge to design against. Symmetric for SCHEDULING: RTC FAST is PRO_CPU's alone
# (3.3.2.7, p.70) and the PID controller is two behind one range (3.3.5.1, p.74), neither of
# which a thread reaches. Targeting: a bank of 69 map registers per CPU (PRO DPORT+0x104..0x214,
# APP +0x218..0x328); 8.3.3 (p.179) disables a source for one CPU by mapping it to an input wired
# to neither core (6, 7, 11, 15, 16, 29). TRIGGER TYPE AND PRIORITY ARE FIXED PER INPUT (Table
# 8.3-2, p.178), so choosing a target chooses the type the line is taken with. The launch: APP_CPU
# comes up on six DPORT and RTC_CNTL writes, and its clock gate resets CLOSED.
config CHIP_ESP32
	bool
	select ARCH_LX6
	select CHIP_SMP_INTERRUPT
	select CHIP_SMP_SYMMETRIC
	select CHIP_SMP_TARGETING

config CHIP_ESP32C6
	bool
	select ARCH_RV32IMAC
	select HAS_MPU

config CHIP_VIRT_RV32
	bool
	select ARCH_RV32IMAC
	select HAS_MPU
	select HAS_TRACE_CLOCK
	select KICKOS_CLOCK_USER

# Interrupt: the die's GIC-500, SGIs 0..15 through ICC_SGI1R_EL1, with no version to choose.
# Symmetric is the CLUSTER's: the four Cortex-A53s; the Cortex-M7 beside them has its own NVIC
# and instruction set, an AMP node no image spans. Targeting: GICD_IROUTER pins a shared line.
# The launch has no vehicle on this machine, and chip_imx8mp.cc refuses a count above one.
config CHIP_IMX8MP
	bool
	select ARCH_ARMV8A
	select HAS_ASPACE
	select CHIP_SMP_INTERRUPT
	select CHIP_SMP_SYMMETRIC
	select CHIP_SMP_TARGETING

# Interrupt: GIC SGIs, a GICv2 by default and a GICv3 under gic-version=3, a machine option here.
# Symmetric: one cluster of identical Cortex-A53s. Targeting: GICD_ITARGETSR on a GICv2,
# GICD_IROUTER on a GICv3. The launch: secondaries held in PSCI, released by CPU_ON over HVC.
config CHIP_VIRT_ARM64
	bool
	select ARCH_ARMV8A
	select HAS_ASPACE
	select CHIP_SMP_INTERRUPT
	select CHIP_SMP_SYMMETRIC
	select CHIP_SMP_TARGETING
	select CHIP_AMP_CONSOLE_CLAIM

# Interrupt: a CLINT msip word per hart, raising a MACHINE software interrupt with mideleg
# read-only zero, so the receive side runs through this chip's machine-mode trampoline
# (startup.S); a supervisor store to a peer's msip word is permitted, so the send has no
# machine-mode leg. Symmetric: identical harts. Targeting: the PLIC's enables are per hart
# context. THIS PORT DRIVES NO PLIC LINE, so the claim is the machine's: its interrupt controller
# is the software one in arch_rv64imac.cc, whose lines are per hart already.
config CHIP_VIRT_RV64
	bool
	select ARCH_RV64IMAC
	select HAS_ASPACE
	select CHIP_SMP_INTERRUPT
	select CHIP_SMP_SYMMETRIC
	select CHIP_SMP_TARGETING

# The QEMU `q35` machine (ICH9). Translating: the firmware's identity map is the kernel half,
# supervisor-only, and a task reaches its frames and the app window one user slot above their
# physical address (docs/design-m10-kernel-share.md section 1).
config CHIP_Q35
	bool
	select ARCH_X86_64
	select HAS_ASPACE
	select CHIP_SMP_INTERRUPT
	select CHIP_SMP_SYMMETRIC
	select CHIP_SMP_TARGETING

config CHIP_RX72M
	bool
	select ARCH_RXV3
	select HAS_MPU

config CHIP_SIM
	bool
	select ARCH_SIM
	select HAS_MPU

