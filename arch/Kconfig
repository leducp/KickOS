# Arch and chip declarations. A chip stanza is pure `select`: it states which
# capabilities the silicon has, and decides no knob's value, so a new chip adds a
# stanza and edits no ladder.
#
# Everything here is unprompted. A chip CONSTANT belongs in
# arch/<arch>/chip/<chip>/include/kickos/chip_limits.h, defined unconditionally on the
# model of config/limits.h: an option whose availability and default depend on no
# hardware fact is not configuration.

# The arch can hold one kernel stack per thread slot resident from boot, and its
# arch_context carries the kernel_sp a trusted entry loads. Declared here rather than
# beside HAS_MPU because it is a fact about the ARCH and not about the silicon: the trap
# entry that transfers to those stacks is written per arch, and a chip selects nothing.
config ARCH_HAS_KERNEL_STACKS
	bool
	help
	  The arch's trap entry can transfer to a per-thread kernel stack, and its
	  arch_context carries the kernel_sp that entry loads. NECESSARY AND NOT
	  SUFFICIENT: whether a given board actually carves the blocks is
	  KICKOS_KERNEL_STACKS, which asks this AND the chip's HAS_MPU, or this AND the
	  board's own BOARD_TAKES_KERNEL_STACKS.

config BOARD_TAKES_KERNEL_STACKS
	bool
	help
	  A board on a chip with NO MPU that pays for the per-thread kernel stacks anyway.

	  WHY THIS IS A BOARD DECISION AND NOT AN ARCH ONE. A chip with no MPU has no
	  privilege boundary for a trusted kernel stack to protect: an unprivileged thread
	  there reaches kernel memory with a plain store, so moving the syscall dispatch
	  off that thread's stack buys ROBUSTNESS and not ISOLATION. The red zone the entry
	  otherwise reserves buys the same robustness at a fifth of the RAM. So on a
	  HAS_MPU chip the transfer is mandatory, because there it is the isolation; on a
	  chip without one it is a RAM trade the board makes.

	  DEFAULT OFF, AND THAT DIRECTION IS DELIBERATE. A new board on a no-MPU chip
	  keeps its red zone until someone does the arena arithmetic and states this,
	  rather than silently acquiring KICKOS_THREAD_SLOTS blocks of kernel .bss its
	  arena cannot back. The failure of the silent version is a link-time arena
	  refusal on the fattest image, which reads as a board that advertises thread
	  slots it cannot seat.

	  WHAT THE OPTED-IN BOARD OWES: the whole per-board derivation, in its defconfig,
	  of the arena it gave up and the usable stack its threads keep. microbit and
	  bluepill-c8 carry theirs.

config ARCH_ARMV6M
	bool
	select ARCH_HAS_KERNEL_STACKS

config ARCH_ARMV7M
	bool
	select ARCH_HAS_KERNEL_STACKS

config ARCH_RXV3
	bool

config ARCH_RV32IMAC
	bool
	select ARCH_HAS_KERNEL_STACKS

config ARCH_LX6
	bool

config ARCH_SIM
	bool
	select HAS_MPU

config KICKOS_ARCH
	string
	default "armv6m" if ARCH_ARMV6M
	default "armv7m" if ARCH_ARMV7M
	default "rxv3" if ARCH_RXV3
	default "rv32imac" if ARCH_RV32IMAC
	default "lx6" if ARCH_LX6
	default "sim" if ARCH_SIM

config KICKOS_ARCH_FAMILY
	string
	default "arm" if ARCH_ARMV6M || ARCH_ARMV7M
	default "rx" if ARCH_RXV3
	default "riscv" if ARCH_RV32IMAC
	default "xtensa" if ARCH_LX6
	default "sim" if ARCH_SIM

config CHIP_IMXRT1062
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_MK64F
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_MPS2
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_NRF51
	bool
	select ARCH_ARMV6M
	select HAS_TRACE_CLOCK

config CHIP_RP2040
	bool
	select ARCH_ARMV6M
	select HAS_MPU
	select HAS_TRACE_CLOCK

config CHIP_RP2350
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_SAM3X8E
	bool
	select ARCH_ARMV7M

config CHIP_STM32F103
	bool
	select ARCH_ARMV7M

config CHIP_STM32F302
	bool
	select ARCH_ARMV7M

config CHIP_STM32F411
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_XMC4800
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_ESP32
	bool
	select ARCH_LX6

config CHIP_ESP32C6
	bool
	select ARCH_RV32IMAC
	select HAS_MPU

config CHIP_VIRT
	bool
	select ARCH_RV32IMAC
	select HAS_MPU
	select HAS_TRACE_CLOCK

config CHIP_RX72M
	bool
	select ARCH_RXV3
	select HAS_MPU

# Empty on the sim, which then leaves config/board.h and config/system.h on their own
# defaults.
config KICKOS_CHIP
	string
	default "imxrt1062" if CHIP_IMXRT1062
	default "mk64f" if CHIP_MK64F
	default "mps2" if CHIP_MPS2
	default "nrf51" if CHIP_NRF51
	default "rp2040" if CHIP_RP2040
	default "rp2350" if CHIP_RP2350
	default "sam3x8e" if CHIP_SAM3X8E
	default "stm32f103" if CHIP_STM32F103
	default "stm32f302" if CHIP_STM32F302
	default "stm32f411" if CHIP_STM32F411
	default "xmc4800" if CHIP_XMC4800
	default "esp32" if CHIP_ESP32
	default "esp32c6" if CHIP_ESP32C6
	default "virt" if CHIP_VIRT
	default "rx72m" if CHIP_RX72M
	default ""
