#
# Arch and chip declarations. A chip stanza is pure `select`: it states which
# capabilities the silicon has, and decides no knob's value, so a new chip adds a
# stanza and edits no ladder.
#
# Nothing here is prompted, and a chip CONSTANT does not appear here at all: if no
# option's availability or default depends on a hardware fact, it is not configuration.
# Those live in arch/<arch>/chip/<chip>/include/kickos/chip_limits.h, defined
# unconditionally on the model of config/limits.h.

config ARCH_ARMV6M
	bool

config ARCH_ARMV7M
	bool

config ARCH_RXV3
	bool

config ARCH_RV32IMAC
	bool

config ARCH_LX6
	bool

config ARCH_SIM
	bool
	select HAS_MPU

config KICKOS_ARCH
	string
	default "armv6m" if ARCH_ARMV6M
	default "armv7m" if ARCH_ARMV7M
	default "rxv3" if ARCH_RXV3
	default "rv32imac" if ARCH_RV32IMAC
	default "lx6" if ARCH_LX6
	default "sim" if ARCH_SIM

config KICKOS_ARCH_FAMILY
	string
	default "arm" if ARCH_ARMV6M || ARCH_ARMV7M
	default "rx" if ARCH_RXV3
	default "riscv" if ARCH_RV32IMAC
	default "xtensa" if ARCH_LX6
	default "sim" if ARCH_SIM

config CHIP_IMXRT1062
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_MK64F
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_MPS2
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_NRF51
	bool
	select ARCH_ARMV6M
	select HAS_TRACE_CLOCK

config CHIP_RP2040
	bool
	select ARCH_ARMV6M
	select HAS_MPU
	select HAS_TRACE_CLOCK

config CHIP_RP2350
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_SAM3X8E
	bool
	select ARCH_ARMV7M

config CHIP_STM32F103
	bool
	select ARCH_ARMV7M

config CHIP_STM32F302
	bool
	select ARCH_ARMV7M

config CHIP_STM32F411
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_XMC4800
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_ESP32
	bool
	select ARCH_LX6

config CHIP_ESP32C6
	bool
	select ARCH_RV32IMAC
	select HAS_MPU

config CHIP_VIRT
	bool
	select ARCH_RV32IMAC
	select HAS_MPU
	select HAS_TRACE_CLOCK

config CHIP_RX72M
	bool
	select ARCH_RXV3
	select HAS_MPU

# The sim has no chip: config/board.h and config/system.h fall through to their
# own defaults, so the string is deliberately empty there.
config KICKOS_CHIP
	string
	default "imxrt1062" if CHIP_IMXRT1062
	default "mk64f" if CHIP_MK64F
	default "mps2" if CHIP_MPS2
	default "nrf51" if CHIP_NRF51
	default "rp2040" if CHIP_RP2040
	default "rp2350" if CHIP_RP2350
	default "sam3x8e" if CHIP_SAM3X8E
	default "stm32f103" if CHIP_STM32F103
	default "stm32f302" if CHIP_STM32F302
	default "stm32f411" if CHIP_STM32F411
	default "xmc4800" if CHIP_XMC4800
	default "esp32" if CHIP_ESP32
	default "esp32c6" if CHIP_ESP32C6
	default "virt" if CHIP_VIRT
	default "rx72m" if CHIP_RX72M
	default ""
