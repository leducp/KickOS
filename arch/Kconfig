# Arch and chip declarations. A chip stanza is pure `select`: it states which
# capabilities the silicon has, and decides no knob's value, so a new chip adds a
# stanza and edits no ladder.
#
# Everything here is unprompted. A chip CONSTANT belongs in
# arch/<arch>/chip/<chip>/include/kickos/chip_limits.h, defined unconditionally on the
# model of config/limits.h: an option whose availability and default depend on no
# hardware fact is not configuration.

# The arch can hold one kernel stack per thread slot resident from boot, and its
# arch_context carries the kernel_sp a trusted entry loads. Declared here rather than
# beside HAS_MPU because it is a fact about the ARCH and not about the silicon: the trap
# entry that transfers to those stacks is written per arch, and a chip selects nothing.
config ARCH_HAS_KERNEL_STACKS
	bool
	help
	  The arch's trap entry can transfer to a per-thread kernel stack, and its
	  arch_context carries the kernel_sp that entry loads. NECESSARY AND NOT
	  SUFFICIENT: whether a given board actually carves the blocks is
	  KICKOS_KERNEL_STACKS, which asks this AND the chip's HAS_MPU.

# STRONGER THAN THE ABOVE: the arch's entry has NO red-zone fallback. Declared here for the
# same reason ARCH_HAS_KERNEL_STACKS is, and separate from it because the two say different
# things: one says the transfer is POSSIBLE, this one says it is the ONLY thing the entry
# compiles.
config ARCH_KERNEL_STACKS_MANDATORY
	bool
	help
	  The arch's switch.S compiles the transfer UNCONDITIONALLY, with no red-zone path
	  beside it, and its backend static_asserts KICKOS_KERNEL_STACKS != 0. Selecting
	  this makes that knob default 1 unconditionally on the arch, so no chip capability
	  or board opt-in can steer it to a value three backends reject, and pins it with
	  `range 1 1` as a declared invariant. A requested 0 is REFUSED BY NAME at configure
	  instead of reaching the assert as a compile error.

	  WHY IT IS NOT IMPLIED BY ARCH_HAS_KERNEL_STACKS. That symbol says the entry CAN
	  transfer; this one says it can do nothing else. armv6m, rv32imac and rxv3 select
	  this: every chip on them either has an MPU or opted in, so the fallback was never
	  written and their asserts have always been the only thing standing behind the
	  knob's `default 0`.

	  ARMV7M DELIBERATELY DOES NOT SELECT IT, and that is what makes the distinction
	  expressible rather than a tautology. It carries BOTH paths under
	  KICKOS_KERNEL_STACKS because stm32f302 and sam3x8e have no MPU and did not opt in:
	  on a chip with no privilege boundary the transfer buys robustness rather than
	  isolation, and the red zone buys the same robustness without KICKOS_THREAD_SLOTS
	  blocks of kernel .bss. f302nucleo and due are those boards, and they must keep
	  resolving 0.

	  A NEW ARCH THAT WRITES ONLY THE TRANSFER SELECTS THIS. One that writes both paths
	  does not, and then the red zone is what its unconverted boards depend on.

# The arch can hand a thread its own thread pointer with no syscall and no kernel read,
# so an unprivileged thread_local access costs no privilege transition. Declared here for
# the same reason ARCH_HAS_KERNEL_STACKS is: which register or call answers the question is
# written per arch, and a chip selects nothing.
config ARCH_HAS_TLS
	bool
	help
	  The arch has a per-thread thread pointer reachable from UNPRIVILEGED code:
	  a register the kernel writes at restore (rv32imac tp, lx6 THREADPTR), or a
	  leaf the kernel provides that derives it from SP (armv7m, armv6m
	  __aeabi_read_tp; rxv3 through its emutls anchor).

	  ARCH_SIM DOES NOT SELECT IT, and cannot. Its threads are ucontext coroutines
	  in ONE host thread sharing one %fs, and instance_local.h already owns host
	  TLS deliberately for the signal handlers. An fs-base swap was probed and
	  segfaults. So the arch with the largest test suite cannot witness this
	  feature at all, and that is stated here rather than left to be discovered.

# HOW that thread pointer is DERIVED, which is a different fact and the one the stack
# geometry pays for. Where the arch has no per-thread register at the unprivileged level it
# masks SP down to KICKOS_TLS_STRIDE, so a stack block must BE one stride and sit on one, or
# two threads mask to the same thread-local storage. Declared here beside ARCH_HAS_TLS
# because which register or idiom answers is written per arch and a chip selects nothing.
config ARCH_TLS_FROM_SP
	bool
	help
	  The unprivileged thread pointer is the STACK POINTER masked down to
	  KICKOS_TLS_STRIDE, so the stride is a real constraint on every stack block:
	  power-of-two size, natural alignment, and one stride exactly.

	  armv6m and armv7m have no choice, the M profile offering no per-thread register
	  to unprivileged code. rv32imac has `tp` and rxv3 an emutls anchor, and both mask
	  anyway, deriving the pointer from the stack rather than from the thread's own
	  block: a chosen uniformity, so the select states it rather than the ISA implying
	  it. lx6 masks in its frame macros.

	  ARMV8A DOES NOT SELECT IT. It seats TPIDR_EL0 from the context, and the context
	  derives that value from the block by SUBTRACTION, so the stack's low bound owes no
	  alignment past the ABI's sixteen bytes. That is what lets a stack there be frames
	  of any page count at any page boundary (docs/design-m6-mmu.md F7).

	  ARCH_SIM does not select it and cannot: it does not select ARCH_HAS_TLS either.

config ARCH_ARMV6M
	bool
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY

config ARCH_ARMV7M
	bool
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS

# A select here is a promise the gates hold this backend to, so each one landed with the
# step that earned it: the kernel-stack pair at S7 with the EL0 split, ARCH_HAS_TLS at S8.
# The pair is MANDATORY rather than optional because EL0 runs on SP_EL0 and a trap to EL1
# selects SP_EL1, so this arch writes the transfer with no red-zone path beside it.
config ARCH_ARMV8A
	bool
	select ARCH_HAS_TLS
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY

config ARCH_RXV3
	bool
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY

config ARCH_RV32IMAC
	bool
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY

# The kernel-stack pair lands here with the trap prologue that earns it: the entry loads the
# block from sscratch before it stores anything and no red-zone path is written beside it.
# MANDATORY comes with it because KICKOS_KERNEL_STACKS reads `default 1 if
# ARCH_HAS_KERNEL_STACKS && HAS_MPU`, so a chip that TRANSLATES gets no such default and the
# knob would resolve 0, failing later as a backend compile error rather than as a configure
# refusal; ARCH_ARMV8A selects the pair the same way. ARCH_HAS_TLS still waits for the step
# that seats the thread pointer. ARCH_TLS_FROM_SP is not coming: this port would seat that
# register from the context, as its arm64 sibling does.
config ARCH_RV64IMAC
	bool
	select ARCH_HAS_KERNEL_STACKS
	select ARCH_KERNEL_STACKS_MANDATORY

config ARCH_LX6
	bool
	select ARCH_HAS_TLS
	select ARCH_TLS_FROM_SP

config ARCH_SIM
	bool
	select HAS_MPU

config KICKOS_ARCH
	string
	default "armv6m" if ARCH_ARMV6M
	default "armv7m" if ARCH_ARMV7M
	default "armv8a" if ARCH_ARMV8A
	default "rxv3" if ARCH_RXV3
	default "rv32imac" if ARCH_RV32IMAC
	default "rv64imac" if ARCH_RV64IMAC
	default "lx6" if ARCH_LX6
	default "sim" if ARCH_SIM

config KICKOS_ARCH_FAMILY
	string
	default "arm" if ARCH_ARMV6M || ARCH_ARMV7M
	default "arm64" if ARCH_ARMV8A
	default "rx" if ARCH_RXV3
	default "riscv" if ARCH_RV32IMAC || ARCH_RV64IMAC
	default "xtensa" if ARCH_LX6
	default "sim" if ARCH_SIM

config CHIP_IMXRT1062
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_MK64F
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_MPS2
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_NRF51
	bool
	select ARCH_ARMV6M
	select HAS_TRACE_CLOCK

config CHIP_RP2040
	bool
	select ARCH_ARMV6M
	select HAS_MPU
	select HAS_TRACE_CLOCK

config CHIP_RP2350
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_SAM3X8E
	bool
	select ARCH_ARMV7M

config CHIP_STM32F103
	bool
	select ARCH_ARMV7M

config CHIP_STM32F302
	bool
	select ARCH_ARMV7M

config CHIP_STM32F411
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_XMC4800
	bool
	select ARCH_ARMV7M
	select HAS_MPU

config CHIP_ESP32
	bool
	select ARCH_LX6

config CHIP_ESP32C6
	bool
	select ARCH_RV32IMAC
	select HAS_MPU

config CHIP_VIRT_RV32
	bool
	select ARCH_RV32IMAC
	select HAS_MPU
	select HAS_TRACE_CLOCK

config CHIP_VIRT_ARM64
	bool
	select ARCH_ARMV8A
	select HAS_ASPACE

config CHIP_VIRT_RV64
	bool
	select ARCH_RV64IMAC
	select HAS_ASPACE

config CHIP_RX72M
	bool
	select ARCH_RXV3
	select HAS_MPU

# Empty on the sim, which then leaves config/board.h and config/system.h on their own
# defaults.
config KICKOS_CHIP
	string
	default "imxrt1062" if CHIP_IMXRT1062
	default "mk64f" if CHIP_MK64F
	default "mps2" if CHIP_MPS2
	default "nrf51" if CHIP_NRF51
	default "rp2040" if CHIP_RP2040
	default "rp2350" if CHIP_RP2350
	default "sam3x8e" if CHIP_SAM3X8E
	default "stm32f103" if CHIP_STM32F103
	default "stm32f302" if CHIP_STM32F302
	default "stm32f411" if CHIP_STM32F411
	default "xmc4800" if CHIP_XMC4800
	default "esp32" if CHIP_ESP32
	default "esp32c6" if CHIP_ESP32C6
	default "virt_rv32" if CHIP_VIRT_RV32
	default "virt_arm64" if CHIP_VIRT_ARM64
	default "virt_rv64" if CHIP_VIRT_RV64
	default "rx72m" if CHIP_RX72M
	default ""
