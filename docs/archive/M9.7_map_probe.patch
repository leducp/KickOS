diff --git a/arch/include/kickos/map_probe.h b/arch/include/kickos/map_probe.h
new file mode 100644
index 00000000..b707fd6d
--- /dev/null
+++ b/arch/include/kickos/map_probe.h
@@ -0,0 +1,101 @@
+// Temporary M9.7 map experiment. This header lives only in the throwaway worktree.
+#pragma once
+
+#include <kickos/arch/arch.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct MapProbeCell
+    {
+        size_t pages;
+        uint64_t scan_sum;
+        uint64_t total_sum;
+        uint64_t scan_min;
+        uint64_t total_min;
+        uint64_t scan_max;
+        uint64_t total_max;
+        uint32_t count;
+    };
+extern "C" unsigned arch_map_preflight_rows(MapProbeCell* out, unsigned cap);
+extern "C" uint32_t arch_map_preflight_failures(void);
+
+#ifdef KICKOS_MAP_PROBE_IMPLEMENTATION
+namespace
+{
+    MapProbeCell g_map_probe[16] = {};
+    bool g_map_probe_running = false;
+    bool g_map_probe_done = false;
+    uint32_t g_map_probe_failures = 0;
+
+    void map_probe_record(size_t pages, uint64_t scan, uint64_t total)
+    {
+        if (!g_map_probe_running || scan == 0 || total == 0)
+        {
+            return;
+        }
+        for (auto& c : g_map_probe)
+        {
+            if (c.count != 0 && c.pages != pages)
+            {
+                continue;
+            }
+            if (c.count == 0)
+            {
+                c.pages = pages;
+                c.scan_min = scan;
+                c.total_min = total;
+            }
+            c.scan_sum += scan;
+            c.total_sum += total;
+            if (scan < c.scan_min) c.scan_min = scan;
+            if (total < c.total_min) c.total_min = total;
+            if (scan > c.scan_max) c.scan_max = scan;
+            if (total > c.total_max) c.total_max = total;
+            c.count++;
+            return;
+        }
+    }
+
+    void map_probe_drive(struct arch_aspace* space, uintptr_t va, arch_phys_addr_t pa,
+                         size_t pages, uint32_t rights, enum arch_map_memtype type)
+    {
+        if (g_map_probe_done || g_map_probe_running || pages < 3 || (rights & ARCH_MAP_X) != 0
+            || arch_clock_now() == 0)
+        {
+            return;
+        }
+        g_map_probe_done = true;
+        g_map_probe_running = true;
+        for (unsigned i = 0; i < 100; i++)
+        {
+            if (arch_aspace_map(space, va, pa, 1, rights, type) != ARCH_ASPACE_OK)
+            {
+                g_map_probe_failures++;
+            }
+            if (arch_aspace_map(space, va, pa, 3, rights, type) != ARCH_ASPACE_OK)
+            {
+                g_map_probe_failures++;
+            }
+        }
+        g_map_probe_running = false;
+    }
+}
+
+extern "C" unsigned arch_map_preflight_rows(MapProbeCell* out, unsigned cap)
+{
+    unsigned used = 0;
+    for (auto const& c : g_map_probe)
+    {
+        if (c.count != 0 && used < cap)
+        {
+            out[used++] = c;
+        }
+    }
+    return used;
+}
+extern "C" uint32_t arch_map_preflight_failures(void)
+{
+    return g_map_probe_failures;
+}
+#endif
