CONFIG_BOARD_BLUEPILL_C8=y

# Enable self-test syscalls and omit the heap to fit boot and worker stacks.
CONFIG_KICKOS_MAX_THREADS=2
CONFIG_KICKOS_MAX_TASKS=4
CONFIG_KICKOS_MAX_DOMAINS=4
CONFIG_KICKOS_MAX_SEMAPHORES=4
CONFIG_KICKOS_MAX_MUTEXES=4
CONFIG_KICKOS_MAX_IRQ_HANDLES=4
# One below each pool above, which the build requires: a budget that reached a pool would
# let one task take its last slot.
CONFIG_KICKOS_TASK_SEMAPHORE_BUDGET=3
CONFIG_KICKOS_TASK_MUTEX_BUDGET=3
CONFIG_KICKOS_TASK_IRQ_HANDLE_BUDGET=3
CONFIG_KICKOS_CAP_TABLE_SUPPLY=7
CONFIG_KICKOS_USER_STACK_SIZE=2048
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=2048
CONFIG_KICKOS_USER_HEAP_SIZE=0
CONFIG_KICKOS_ENABLE_SELFTEST=y

# 64 KiB of flash: the kernel says its diagnostics in the short column of
# include/kickos/diag.h, and an assert names its file and line instead of its condition.
CONFIG_KICKOS_DIAG_TERSE=1
