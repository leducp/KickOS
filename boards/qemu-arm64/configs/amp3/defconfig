CONFIG_BOARD_QEMU_ARM64=y

# ONE image per node, which is the ordinary AMP shape: this image drives one core and names
# peers it never launches. The node index is the only thing that differs between the three
# builds of this partition, and the preset states it.
CONFIG_KICKOS_CORES_ONE=y
CONFIG_KICKOS_AMP_POSTURE_OWN_IMAGE=y
CONFIG_ARM64_GIC_V3=y

# The partition. THREE nodes of 64 MiB from the DRAM base, with the region every node writes
# above all of them. The emulated machine's DRAM and core count are sized from these.
#
# Three and not two: every "each peer against node 0" shortcut is correct at two nodes and
# wrong at three, so the third node is what separates a bound from a collapse.
CONFIG_KICKOS_AMP_NODES=3
CONFIG_KICKOS_AMP_PARTITION_BASE=0x40000000
CONFIG_KICKOS_AMP_NODE_SHARE=0x4000000
CONFIG_KICKOS_AMP_SHARED_SIZE=0x200000

# The node-to-core map, in node order. A node index is not a core index. Node 0 takes core 0:
# it is the partition primary and runs on the core the machine resets into.
CONFIG_KICKOS_AMP_PARTITION_CORES=3
CONFIG_KICKOS_AMP_NODE_CORES="0,1,2"

# The partition's crossings, stated once and read identically by every node's image. Node 0
# serves port 2, node 1 serves 3 and 4, node 2 serves 5; each image derives its own two sets
# from its own index.
#
# Node 1's second port is bound by its kernel, as a node binds every port the partition names
# it, and its app receives on the first alone. That leaves a bound port with NO RECEIVER, which
# is what gives an arm a far port to park a caller on. Width does not supply one: node 2's port
# is bound and served like node 1's first.
CONFIG_KICKOS_AMP_PORTS="0:2,1:3,1:4,2:5"

# The partition's ports take endpoint slots for the life of the image, one per entry above: a
# local entry claims the endpoint its port is bound to, a far one the endpoint that names the
# crossing. This is a supply, so it covers those plus what the app holds beside them.
CONFIG_KICKOS_MAX_ENDPOINTS=10

CONFIG_KICKOS_USER_STACK_SIZE=12288
CONFIG_KICKOS_IDLE_STACK_SIZE=4096
CONFIG_KICKOS_ROOT_STACK_SIZE=20480

CONFIG_KICKOS_ENABLE_SELFTEST=y
