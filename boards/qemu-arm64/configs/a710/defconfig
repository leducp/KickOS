CONFIG_BOARD_QEMU_ARM64=y

# The four-core posture, run on a Cortex-A710 (KICKOS_QEMU_CPU) rather than the board's A53:
# the same image, with PAN where the A53 takes the reserved-root form.
CONFIG_KICKOS_CORES_FOUR=y

CONFIG_KICKOS_USER_STACK_SIZE=12288
CONFIG_KICKOS_IDLE_STACK_SIZE=4096
CONFIG_KICKOS_ROOT_STACK_SIZE=20480

CONFIG_KICKOS_MAX_SPAWN_GRANTS=9
