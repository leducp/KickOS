CONFIG_BOARD_QEMU_ARM64=y

# The context-switch microbench, at the BASE posture rather than a relaxed one: this board
# has no non-enforcing variant to fall back to, its protection being the stage-1 tables and
# not a knob, so base is the only posture its figures can be taken under.
# The stack sizes are base's: this arch's exception frame is 800 bytes and idle takes a timer
# interrupt on its own stack, so a smaller idle stack would not hold two frames.
CONFIG_KICKOS_USER_STACK_SIZE=12288
CONFIG_KICKOS_IDLE_STACK_SIZE=4096
CONFIG_KICKOS_ROOT_STACK_SIZE=20480
CONFIG_KICKOS_ENABLE_SELFTEST=y
CONFIG_KICKOS_BENCH=y

# No service list is pinned because this board declares none and the default is already
# kickos_services_none: a console driver is a thread and its device is an interrupt source,
# and both would compete with the bench peers for the window being timed.
