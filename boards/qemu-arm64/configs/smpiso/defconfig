CONFIG_BOARD_QEMU_ARM64=y

# The smp posture with one clause added: core 3 is held out of the default core set, so only a
# thread whose explicit mask names it reaches that core. Core 0 is the boot core and may not be
# named here; the configure refuses bit 0 outright.
CONFIG_KICKOS_CORES_FOUR=y
CONFIG_KICKOS_ISOLATED_CORES=0x8

CONFIG_KICKOS_USER_STACK_SIZE=12288
CONFIG_KICKOS_IDLE_STACK_SIZE=4096
CONFIG_KICKOS_ROOT_STACK_SIZE=20480

CONFIG_KICKOS_ENABLE_SELFTEST=y
