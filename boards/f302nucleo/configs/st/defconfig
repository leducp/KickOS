CONFIG_BOARD_F302NUCLEO=y

# Adds the test-only self-test syscalls the TAP suite calls. On 64 KiB of flash and
# 16 KiB of SRAM the suite is split over two images, the heap goes entirely, and the
# pools buy back what the arms need.
CONFIG_KICKOS_MAX_THREADS=3
CONFIG_KICKOS_MAX_SEMAPHORES=6
CONFIG_KICKOS_MAX_IRQ_HANDLES=4
CONFIG_KICKOS_CAP_TABLE_SUPPLY=7
CONFIG_KICKOS_USER_STACK_SIZE=1024
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=1536
CONFIG_KICKOS_USER_HEAP_SIZE=0
CONFIG_KICKOS_ENABLE_SELFTEST=y

# 64 KiB of flash: the kernel says its diagnostics in the short column of
# include/kickos/diag.h, and an assert names its file and line instead of its condition.
CONFIG_KICKOS_DIAG_TERSE=1
