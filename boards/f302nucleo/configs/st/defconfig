CONFIG_BOARD_F302NUCLEO=y

# Fit self-tests into three images with no heap and reduced pools.
CONFIG_KICKOS_MAX_THREADS=2
CONFIG_KICKOS_MAX_TASKS=4
CONFIG_KICKOS_MAX_DOMAINS=4
CONFIG_KICKOS_MAX_SEMAPHORES=6
CONFIG_KICKOS_MAX_IRQ_HANDLES=4
# One below each pool above, which the build requires. Five is one short of the six
# semaphores the suite deadlock arm holds live, so that arm SKIPs here as it always has.
CONFIG_KICKOS_TASK_SEMAPHORE_BUDGET=5
CONFIG_KICKOS_TASK_IRQ_HANDLE_BUDGET=3
CONFIG_KICKOS_CAP_TABLE_SUPPLY=7
CONFIG_KICKOS_USER_STACK_SIZE=1024
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=1536
CONFIG_KICKOS_USER_HEAP_SIZE=0
CONFIG_KICKOS_ENABLE_SELFTEST=y

# 64 KiB of flash: the kernel says its diagnostics in the short column of
# include/kickos/diag.h, and an assert names its file and line instead of its condition.
CONFIG_KICKOS_DIAG_TERSE=1

# TLS requires power-of-two stack strides, which this configuration does not provide.
# CONFIG_KICKOS_TLS is not set
