CONFIG_BOARD_QEMU_RISCV64=y

# The base posture with one clause changed, so what the two report is attributable to that
# clause: four translation levels instead of three (docs/design-m6-mmu.md R3). The emulated
# core implements the mode; the prologue reads satp.MODE back and refuses by name on a hart
# that does not.
CONFIG_RV64_PAGING_SV48=y

CONFIG_KICKOS_USER_STACK_SIZE=12288
CONFIG_KICKOS_IDLE_STACK_SIZE=4096
CONFIG_KICKOS_ROOT_STACK_SIZE=20480

CONFIG_KICKOS_ENABLE_SELFTEST=y
