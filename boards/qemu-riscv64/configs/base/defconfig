CONFIG_BOARD_QEMU_RISCV64=y

# Only what differs from the Kconfig defaults, as savedefconfig would write it and in
# the declaration order it uses.
# A stack size here owes no stride alignment: this arch would seat the thread pointer from the
# context rather than masking SP down to a stride, so it selects no ARCH_TLS_FROM_SP. No TLS is
# selected yet and nothing reads tp; the trap entry forces it to zero beside gp.
CONFIG_KICKOS_USER_STACK_SIZE=12288
CONFIG_KICKOS_IDLE_STACK_SIZE=4096
CONFIG_KICKOS_ROOT_STACK_SIZE=20480

CONFIG_KICKOS_ENABLE_SELFTEST=y
