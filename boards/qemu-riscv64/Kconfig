# QEMU virt (RV64). No pads and no driver handover, so the board declares neither a
# service list nor a pin map; what IS this board's rather than its chip's is how much RAM
# it has, which is what the heap the linker script carves is bounded by.

if BOARD_QEMU_RISCV64

config KICKOS_USER_HEAP_SIZE
	int
	default 65536

endif
