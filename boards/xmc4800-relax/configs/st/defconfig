CONFIG_KICKOS_TASK_ENDPOINT_BUDGET=4
CONFIG_KICKOS_USER_STACK_SIZE=4096
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=4096
CONFIG_CONSOLE_BOTH=y
CONFIG_KICKOS_ENABLE_SELFTEST=y
CONFIG_KICKOS_MAX_SPAWN_GRANTS=9
