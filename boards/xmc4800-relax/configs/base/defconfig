CONFIG_BOARD_XMC4800_RELAX=y

# Its native transport is USIC and it carries an onboard J-Link, so it is the one
# board whose console is visible on a tty AND over JLinkRTTClient.
CONFIG_MEMORY_MODEL_MPU=y
CONFIG_KICKOS_MAX_THREADS=8
CONFIG_KICKOS_MAX_TASKS=10
CONFIG_KICKOS_MAX_DOMAINS=10
# The default service list keeps two endpoints in root for the life of the image (the
# published console and the retained SPI one), and the selftest holds two at once: the
# per-task ceiling has to seat four, and the pool sits one above it.
CONFIG_KICKOS_MAX_ENDPOINTS=5
CONFIG_KICKOS_TASK_ENDPOINT_BUDGET=4
CONFIG_KICKOS_USER_STACK_SIZE=4096
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=4096
CONFIG_CONSOLE_BOTH=y
