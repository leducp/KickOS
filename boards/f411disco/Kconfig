# STM32F411 Discovery board wiring. See boards/blackpill/Kconfig: the two boards share
# a chip and differ in exactly these five facts, which is the whole reason the tier
# exists.

if BOARD_F411DISCO

config KICKOS_HSE_HZ
	int
	default 8000000

config KICKOS_LED_GPIO
	hex
	default 0x40020C00

config KICKOS_LED_RCC_AHB1_BIT
	int
	default 3

config KICKOS_LED_PIN
	int
	default 12

config KICKOS_LED_ACTIVE_LOW
	int
	default 0

endif
