CONFIG_BOARD_F411DISCO=y

# Enforcing ARMv7-M microbench with a stable cycle counter and histograms.
CONFIG_MEMORY_MODEL_MPU=y
CONFIG_KICKOS_MAX_THREADS=8
CONFIG_KICKOS_MAX_TASKS=10
CONFIG_KICKOS_MAX_DOMAINS=10
CONFIG_KICKOS_USER_STACK_SIZE=4096
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=4096
CONFIG_KICKOS_ENABLE_SELFTEST=y
CONFIG_KICKOS_BENCH=y

# Use the default empty service list to avoid driver and IRQ interference.
# Output still reaches the kernel console through kickos::emit.
