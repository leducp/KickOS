CONFIG_BOARD_ESP32C6_WROOM=y

# The call/reply phase decomposition. Mirrors `st`'s ENFORCING posture minus the
# self-test syscalls, which nothing in the bench app calls. rv32imac PENDS its switch,
# so this board's COMPOSITE spans close before the lock does and are readable; the LX6
# swaps inline and its composites read as elapsed-until-resumed.
CONFIG_MEMORY_MODEL_MPU=y
CONFIG_KICKOS_USER_STACK_SIZE=8192
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=8192
CONFIG_KICKOS_BENCH=y
