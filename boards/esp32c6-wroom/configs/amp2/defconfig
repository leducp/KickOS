CONFIG_BOARD_ESP32C6_WROOM=y
CONFIG_KICKOS_CORES_ONE=y
CONFIG_KICKOS_AMP_POSTURE_OWN_IMAGE=y
CONFIG_MEMORY_MODEL_FLAT=y

# A 204 KiB HP node slice, a 276 KiB LP node slice and one 32 KiB shared window in the
# 512 KiB HP SRAM. The LP reset vector alone sits in its 16 KiB LP SRAM; its kernel runs in
# node 1's slice. The HP node's task images run from flash and its userbench bounds how far its
# slice shrinks; the LP node's build links every image in its slice, and its cxxtest bounds it.
CONFIG_KICKOS_AMP_NODES=2
CONFIG_KICKOS_AMP_PARTITION_BASE=0x40800000
CONFIG_KICKOS_AMP_NODE_SLICES="0x33000,0x45000"
CONFIG_KICKOS_AMP_SHARED_SIZE=0x8000
CONFIG_KICKOS_AMP_USER_SHARE_SIZE=0x4000
CONFIG_KICKOS_AMP_PARTITION_CORES=2
CONFIG_KICKOS_AMP_NODE_CORES="0,1"
CONFIG_KICKOS_AMP_PORTS="0:2,1:3,1:4,0:6"
# The HP node drives UART0; the LP node's kernel has no console, and its tasks write through
# the HP node's relay.
CONFIG_KICKOS_AMP_CONSOLES="/dev/uart0,none"
CONFIG_KICKOS_AMP_DIAG_REPORT=1
# The selftest's main holds the crossings its composition names beside the stdout slot and
# the 8 it holds at once, in a child's table.
CONFIG_KICKOS_MAX_SPAWN_GRANTS=12

CONFIG_KICKOS_BUDGET_ENDPOINTS=9
CONFIG_KICKOS_USER_STACK_SIZE=8192
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=4096
CONFIG_KICKOS_LIBC_NANO_DEFAULT=y
