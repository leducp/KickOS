CONFIG_BOARD_ESP32C6_WROOM=y
CONFIG_KICKOS_CORES_ONE=y
CONFIG_KICKOS_AMP_POSTURE_OWN_IMAGE=y
CONFIG_MEMORY_MODEL_FLAT=y

# Two 240 KiB node slices and one 32 KiB shared window in the 512 KiB HP SRAM.
# The LP reset vector alone sits in its 16 KiB LP SRAM; its kernel runs in node 1's slice.
CONFIG_KICKOS_AMP_NODES=2
CONFIG_KICKOS_AMP_PARTITION_BASE=0x40800000
CONFIG_KICKOS_AMP_NODE_SHARE=0x3C000
CONFIG_KICKOS_AMP_SHARED_SIZE=0x8000
CONFIG_KICKOS_AMP_PARTITION_CORES=2
CONFIG_KICKOS_AMP_NODE_CORES="0,1"
CONFIG_KICKOS_AMP_PORTS="0:2,1:3,1:4"
CONFIG_KICKOS_AMP_DIAG_REPORT=1
CONFIG_KICKOS_ENABLE_SELFTEST=y

CONFIG_KICKOS_MAX_ENDPOINTS=9
CONFIG_KICKOS_TASK_ENDPOINT_BUDGET=8
CONFIG_KICKOS_MAX_THREADS=6
CONFIG_KICKOS_MAX_TASKS=8
CONFIG_KICKOS_MAX_DOMAINS=8
CONFIG_KICKOS_USER_STACK_SIZE=8192
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=8192
