# BBC micro:bit (nRF51822). The toolchain file picks the newlib profile before Kconfig runs.

if BOARD_MICROBIT

config KICKOS_MICROBIT_FULL_NEWLIB
	bool "Link full newlib instead of nano"
	default n
	help
	  Set from the CMake cache variable of the same name, which the toolchain file has
	  already acted on and which outranks a value set here. Full newlib keeps each
	  thread's libc scratch inside its _reent, so KICKOS_USER_HEAP_SIZE defaults to 0
	  under it and to a heap that scratch fits in under nano.

endif
