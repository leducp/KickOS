CONFIG_BOARD_MICROBIT=y

# 16 KiB of SRAM with no arena slack, so every pool here is at or near its floor.
# Its CI gate is the TAP suite, so the self-test syscalls are part of the base
# posture rather than a variant of it.
#
# THE STACKS ARE 1408 BECAUSE THE KERNEL BLOCKS ARE IN .bss NOW, AND A THREAD STILL
# ENDS UP WITH MORE STACK THAN BEFORE. Three slots of KICKOS_KERNEL_STACK_SIZE (896
# on armv6m) is 2688 bytes of kernel .bss below the arena, which takes the arena from
# 7584 to 4896 and leaves it unable to back idle + root + two 2048-byte pool stacks.
# nrf51 has no MPU, so arch_mpu_min_region is 0 and arch_ram_region_size is
# byte-granular to 16: the size is a free choice, not a power-of-two step.
#
# 512 + 3 x 1408 is 4736 of the 4896, so 160 spare. What a thread may use is the size
# less the red zone the syscall site still reserves, which the transfer onto the kernel
# block took from 740 to 40 (armv6m_trap_stack.h derives both): 1408 - 40 is 1368
# against 2048 - 740 = 1308 before, so 60 bytes BETTER on a stack 640 bytes smaller.
#
# WHAT IT COSTS is arena headroom, and the cliff below is real: 928 bytes spare became
# 160, and three TAP arms that used to run now report SKIP. selftest's CMakeLists names
# them and says so.
CONFIG_KICKOS_MAX_THREADS=2
CONFIG_KICKOS_MAX_SEMAPHORES=4
CONFIG_KICKOS_MAX_IRQ_HANDLES=4
CONFIG_KICKOS_CAP_TABLE_SUPPLY=7
CONFIG_KICKOS_USER_STACK_SIZE=1408
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=1408
CONFIG_KICKOS_ENABLE_SELFTEST=y
