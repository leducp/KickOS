CONFIG_BOARD_MICROBIT=y

# Use 32 KiB SRAM for the emulated target; hardware has 16 KiB.
# Four threads leave room for kernel stacks and libc state.
# Use 2048-byte stacks for power-of-two TLS strides. Enable self-test
# syscalls in the base configuration used by CI.
CONFIG_KICKOS_MAX_THREADS=4
CONFIG_KICKOS_MAX_TASKS=6
CONFIG_KICKOS_MAX_DOMAINS=6
CONFIG_KICKOS_USER_STACK_SIZE=2048
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=2048
CONFIG_KICKOS_ENABLE_SELFTEST=y

# A 128-byte line limit keeps the derived TX ring at 256 bytes and covers
# the board's diagnostics. Further reduction conflicts with fault-record sizing.
# The irq_as_event test can still skip when its 4 KiB allocation does not fit.
CONFIG_KICKOS_DIAG_LINE_MAX=128
