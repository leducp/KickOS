CONFIG_BOARD_MICROBIT=y

# 32 KiB of SRAM, which is a DELIBERATE DEPARTURE from the BBC micro:bit v1's 16.
# arch/arm/chip/nrf51/nrf51.ld carries the reason and the QEMU property that makes it
# real. What it buys is this board: the fleet's only executable armv6m target, provisioned
# like the rest of the fleet instead of at its floor, so what runs here is what runs
# everywhere. The arena the fattest image leaves went from 4896 bytes to 21280.
#
# THE STARVATION OVERRIDES ARE GONE. KICKOS_MAX_SEMAPHORES, KICKOS_MAX_IRQ_HANDLES and
# KICKOS_CAP_TABLE_SUPPLY were cut to 4, 4 and 7 to fit 16 KiB, and three TAP arms reported
# SKIP as a result. They now take the fleet defaults.
#
# 2048 AND NOT 1408, because KICKOS_TLS strides every arena block by a power of two: the
# armv6m thread pointer is SP masked down to the block, and 1408 would round the stride to
# 2048 anyway and waste the difference as padding rather than stack.
#
# FOUR AND NOT THE FLEET'S EIGHT. Eight does not fit even at 32 KiB: KICKOS_THREAD_SLOTS
# blocks of KICKOS_KERNEL_STACK_SIZE (896 on armv6m) sit in kernel .bss BELOW the arena, so
# raising the count shrinks the arena and grows the demand at once. At eight the arena is
# about 12800 against a demand of 18944; at six it is 15488 against 14848, which fits with
# 640 bytes and no room for the suite to grow; at four it is 18176 against 10752.
#
# Its CI gate is the TAP suite, so the self-test syscalls are part of the base posture
# rather than a variant of it.
CONFIG_KICKOS_MAX_THREADS=4
CONFIG_KICKOS_USER_STACK_SIZE=2048
CONFIG_KICKOS_IDLE_STACK_SIZE=512
CONFIG_KICKOS_ROOT_STACK_SIZE=2048
CONFIG_KICKOS_ENABLE_SELFTEST=y

