# WeAct STM32F411 board wiring. Nothing here is prompted: a soldered crystal and an
# LED's port and pin are facts of the board, so the board states them and no
# configuration can contradict them.

if BOARD_BLACKPILL

config KICKOS_HSE_HZ
	int
	default 25000000

config KICKOS_LED_GPIO
	hex
	default 0x40020800

config KICKOS_LED_RCC_AHB1_BIT
	int
	default 2

config KICKOS_LED_PIN
	int
	default 13

config KICKOS_LED_ACTIVE_LOW
	int
	default 1

endif
