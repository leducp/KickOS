CONFIG_BOARD_ESP32_WROOM=y

# Two cores under the shared model, which is the Kconfig default above one core.
CONFIG_KICKOS_CORES_TWO=y

# Only what differs from the Kconfig defaults, as savedefconfig would write it and in
# the declaration order it uses.
CONFIG_KICKOS_USER_STACK_SIZE=4096
CONFIG_KICKOS_IDLE_STACK_SIZE=896
CONFIG_KICKOS_ROOT_STACK_SIZE=4096
CONFIG_KICKOS_ENABLE_SELFTEST=y
