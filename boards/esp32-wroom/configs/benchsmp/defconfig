CONFIG_BOARD_ESP32_WROOM=y

# The bench on BOTH cores under one kernel. It exists because the LX6 has no emulator, so
# every other shared-kernel figure this project holds comes from a QEMU guest and this is the
# only path to a lock measurement on a part whose conditional store has no derivable bound.
CONFIG_KICKOS_CORES_TWO=y

CONFIG_KICKOS_MAX_THREADS=8
CONFIG_KICKOS_MAX_TASKS=10
CONFIG_KICKOS_MAX_DOMAINS=10
CONFIG_KICKOS_USER_STACK_SIZE=4096
CONFIG_KICKOS_IDLE_STACK_SIZE=960
CONFIG_KICKOS_ROOT_STACK_SIZE=4096
CONFIG_KICKOS_ENABLE_SELFTEST=y
CONFIG_KICKOS_BENCH=y
