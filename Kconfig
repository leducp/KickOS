# KickOS configuration. Symbols are declared without a prefix, as in every Kconfig
# dialect; the tooling adds CONFIG_ when it writes .config and the generated header.

mainmenu "KickOS configuration"

# --- Capability facts -------------------------------------------------------
# Never prompted: a chip or an arch selects them. A fact earns a declaration here
# only when some option's availability or default depends on it, so this list is
# short on purpose and grows when an option needs it, not when silicon has it.

config HAS_MPU
	bool
	help
	  The chip carves the KICKOS_HAVE_MPU .appdata window AND its arch ships a
	  real arch_mpu_apply, so enforcement faults instead of granting no regions.

config HAS_TRACE_CLOCK
	bool
	default y if ARCH_SIM || ARCH_ARMV7M || ARCH_RXV3 || ARCH_LX6
	help
	  An arch_trace_now exists AND the core it runs on implements the counter it
	  reads. A chip that has a usable counter selects it back on. rv32imac is
	  per-chip because the arch reader is rdcycle: it is legal on the QEMU virt
	  core and traps as an illegal instruction on the ESP32-C6 HP core, which
	  implements no Zicntr counter (C6 TRM v1.2 section 1.5.1; witnessed in
	  M-mode on silicon).

config KICKOS_TRACE_CLOCK_DECLARED
	int
	default 1 if HAS_TRACE_CLOCK
	default 0
	help
	  HAS_TRACE_CLOCK as a number the generated fragment can carry. The capability
	  is stated twice: here, and by arch/<family>/chip/<chip>/caps.cmake plus the
	  arch ladder in CMakeLists.txt. This is the half CMake cannot compute, so it is
	  what the agreement check there compares against.

source "boards/Kconfig"
source "boards/*/Kconfig"
source "arch/Kconfig"

# --- Cores ------------------------------------------------------------------

config KICKOS_NUM_CORES
	int
	default 1
	help
	  How many cores the kernel schedules on. Never prompted: a property of the
	  silicon and the port. At 1, arch_cpu_id() is a macro expanding to a literal and
	  no fallback TU exists, so a multi-core port that raises this and ships no
	  arch_cpu_id gets a link error rather than a kernel that believes it is on core 0.

# --- Memory protection ------------------------------------------------------

choice
	prompt "Memory model"
	default MEMORY_MODEL_FLAT

config MEMORY_MODEL_FLAT
	bool "Flat, no protection"

config MEMORY_MODEL_MPU
	bool "MPU / PMSA / PMP / RX-MPU region enforcement"
	depends on HAS_MPU
	help
	  Offered where a wild cross-domain access actually FAULTS, which needs the
	  chip's linker script to carve the .appdata window AND its arch to ship a
	  real arch_mpu_apply. A chip declares the capability by
	  selecting HAS_MPU in arch/Kconfig, which is also where to look for the
	  chips that can; bringing a new one up means the window, the backend, and
	  then that select once enforcement is validated on hardware.

endchoice

config KICKOS_HAVE_MPU
	int
	default 1 if MEMORY_MODEL_MPU
	default 0

# --- Userspace services and pin mux -----------------------------------------
# Both name a CMake target: the one defining kickos_board_services, and the one
# defining kickos_board_pinmap. A board states its own default in
# boards/<board>/Kconfig; the default here is the no-op every other board takes.
#
# Prompted, unlike the chip constants, because WHICH provider an image runs is a real
# choice and the tree proves it: four sim gates build the same board against different
# providers to exercise publish, panic-flush and driver death.

config KICKOS_SERVICE_LIST
	string "CMake target defining kickos_board_services"
	default "kickos_services_none"

config KICKOS_BOARD_PINMAP
	string "CMake target defining kickos_board_pinmap"
	default "kickos_pinmap_none"

# --- Kernel provisioning ----------------------------------------------------

menu "Kernel provisioning"

config KICKOS_MULTI_INSTANCE
	bool "Several independent kernels in one address space"
	depends on ARCH_SIM
	default n
	help
	  Host one kernel per emulated MCU in a single process, which is how a fleet of
	  KickCAT slaves gets driven against an emulator and how the driver APIs get
	  exercised at scale. Gated to the sim: the selector is keyed on the host thread,
	  and a chip has neither host threads nor a second kernel to select.

	  Off, kickos_instance_index() folds to the literal 0, so the image carries one
	  literal for it and no load, multiply, branch or symbol, on the arch_cpu_id
	  model.

config KICKOS_MAX_INSTANCES
	int "Independent kernels the image provisions" if KICKOS_MULTI_INSTANCE
	range 1 256
	default 64 if KICKOS_MULTI_INSTANCE
	default 1
	help
	  Every instance-scoped object is this many copies, so raising it costs .bss
	  linearly across the whole tree, not just struct Kernel. It is a provisioning
	  bound like the pool sizes, not a preference.

config KICKOS_MAX_THREADS
	int "Static thread pool"
	range 2 64
	default 16

config KICKOS_MAX_SEMAPHORES
	int "CAP_SEM pool"
	range 0 64
	default 16

config KICKOS_MAX_MUTEXES
	int "CAP_MUTEX pool"
	range 0 64
	default 8

config KICKOS_MAX_ENDPOINTS
	int "IPC endpoint pool"
	range 0 32
	default 4

config KICKOS_MAX_IRQ_HANDLES
	int "Tier-1 IRQ-as-event handles"
	range 0 32
	default 8

config KICKOS_MAX_SPAWN_GRANTS
	int "Caps one spawn may delegate"
	range 2 16
	default 6
	help
	  Costs caller stack, not .bss: thread_spawn stages the grant list in arrays
	  on the calling thread's own stack. The floor is 2, not 1: the child width is
	  this plus one plus the reply peak, and a width inside the reserved index
	  range leaves a child no slot of its own, which configure refuses.

config KICKOS_CAP_TABLE_SUPPLY
	int "Capability slots this board's RAM can back"
	range 7 64
	default 16
	help
	  SUPPLY, not demand. The width is summed from declared demand and refused
	  above this.

config KICKOS_USER_STACK_SIZE
	int "Default spawned-thread stack"
	range 512 262144
	default 65536
	help
	  What a spawn with no stack_base gets. Threads on it make syscalls, so it
	  must clear KICKOS_MIN_STACK_SIZE; the range floor here cannot say that,
	  the floor being per-arch, so thread.h asserts the relation instead and a
	  setting below it fails the build rather than the thread.

config KICKOS_IDLE_STACK_SIZE
	int "Idle thread stack"
	range 512 262144
	default 65536
	help
	  Idle is privileged and its body is arch_idle_wait alone, so it never enters
	  the syscall path and KICKOS_MIN_STACK_SIZE does not bind it. What does is
	  the PREEMPTION red zone, the frame a tick or a device IRQ builds on the
	  stack it interrupted plus whatever the kernel runs below that: 384 on
	  rv32imac, the deepest in the fleet. The range floor is 512 rather than 256
	  for exactly that reason, so no setting this accepts can have idle killed by
	  the trap prologue on its first preemption.

config KICKOS_ROOT_STACK_SIZE
	int "Root thread stack"
	range 512 262144
	default 65536
	help
	  Root runs userspace's ctors and main, so it makes syscalls and is bound by
	  KICKOS_MIN_STACK_SIZE the way a spawned thread is. kmain.cc asserts it.

config KICKOS_USER_HEAP_SIZE
	int "Userspace heap the linker script carves"
	range 0 1048576
	default 0 if CHIP_NRF51
	default 2048 if CHIP_STM32F302
	# 20 KiB of SRAM, so this cannot carry the 8192 its 128 KiB F411 sibling does:
	# at 8192 the heaviest stm32f103 image had zero arena past the two boot stacks.
	default 2048 if CHIP_STM32F103
	default 8192 if CHIP_STM32F411
	default 16384
	help
	  Read by the linker script. Every byte here is a byte the thread arena does
	  not get. Zero carves nothing and still prints: newlib falls back
	  to unbuffered stdio when the buffer malloc fails.

config KICKOS_KERNEL_STACKS
	int
	default 1 if ARCH_HAS_KERNEL_STACKS && HAS_MPU
	default 1 if ARCH_HAS_KERNEL_STACKS && BOARD_TAKES_KERNEL_STACKS
	default 0
	help
	  Whether THIS board carves the per-thread kernel stacks, as a number the generated
	  header and the CMake fragment can carry, on the KICKOS_HAVE_MPU model. At 1 the
	  KICKOS_THREAD_SLOTS blocks of KICKOS_KERNEL_STACK_SIZE are one array in kernel
	  .bss, kmain arms each slot's canary and fill at init, and thread_create seats each
	  pool thread's ctx.kernel_sp on its slot's block. At 0 the array is not compiled,
	  every kernel_sp stays 0, and the arch entry keeps its red zone instead.

	  TWO CONDITIONS, AND THE SECOND IS THE CHIP CAPABILITY AND NOT THE BOARD POSTURE.
	  HAS_MPU says the silicon can enforce; MEMORY_MODEL_MPU, and so KICKOS_HAVE_MPU,
	  says this variant switched it on. The question here is whether the board can
	  AFFORD the blocks, which is a RAM question, and RAM does not change between a
	  board's enforcing and flat variants. Keying on the capability also stops one
	  board's variants compiling different entry paths, which would put the arch's
	  syscall geometry inside a per-variant #if.

	  ARCH_HAS_KERNEL_STACKS alone is not enough: on a chip with no MPU the transfer
	  buys robustness rather than isolation, so it is a board decision.
	  BOARD_TAKES_KERNEL_STACKS in arch/Kconfig carries that principle and its default.

	  NOT AN ARENA CARVE, so cmake/boot_arena.cmake names nothing here. The block grows
	  kernel .bss, which raises __kickos_ram_start and shrinks the arena above it, and
	  the two arena asserts in arch/common/boot_arena.ld.h refuse the link when what is
	  left cannot back the boot stacks or the thread pool. Measured on esp32c6-wroom-st:
	  at 16384 the image still fits HP SRAM and KICKOS_POOL_ARENA_ASSERT alone refuses.

config KICKOS_KERNEL_STACK_SIZE
	int "Per-thread kernel stack"
	range 256 65536
	default 1184 if ARCH_RV32IMAC
	default 992 if ARCH_ARMV7M
	default 896 if ARCH_ARMV6M
	default 1024
	help
	  The stack a thread's PRIVILEGED dispatch runs on, once the trap entry
	  transfers to it instead of continuing on the thread's own. One size class
	  per board, so it is a constant here and not a per-thread field.

	  A MEASURED REQUIREMENT ON EVERY ARCH WHOSE ENTRY HAS MOVED, which is
	  rv32imac, armv7m and armv6m, and a BUDGET CEILING on rxv3, whose entry has
	  not. What a kernel stack must hold cannot be measured before the entry
	  transfers to it, and how much lands there depends on decisions that entry
	  work has to make, so on rxv3 this is still a bound to allocate against and
	  to tighten later, never a claim about what the kernel uses.

	  WHAT THE MEASURED ARCHES DERIVE. trap_redzone_roots.txt declares the
	  transferred class stack=kernel and check_trap_redzone.sh measures it against
	  this knob rather than against the spawn floor. A stack=kernel class counts
	  the panic tail, a kernel array having no spawn floor to clear, which makes
	  every figure below CONSOLE-SHAPED and therefore the worse of that arch's
	  REGISTERED presets and not one board's reading.

	  rv32imac: the ecall frame, the dispatch below it, the msip frame a blocking
	  dispatch takes at that depth and the switcher below that, 256 + 912 + 0 is
	  1168 on esp32c6-wroom-st, so 1184.

	  armv7m: svc_trampoline's 16-byte continuation header, the dispatch below it,
	  and the STKALIGN pad plus FP-live hardware frame plus PendSV block a
	  preemption takes at that depth, 224 + 760 is 984 on frdmk64f-st, so 992.

	  armv6m: the same shape with no FP term, 84 + 808 is 892 on picopi-st, so 896.

	  Each arch backend static_asserts its own pair, so a ceiling under its own
	  requirement fails the build rather than the board.

	  A BOARD MAY ONLY RAISE IT. The per-arch static_assert prices the ARCH depth
	  macro, so a defconfig figure below the arch default fails the build even on a
	  board whose own reading is lower: f302nucleo-st measures 680 rather than 760,
	  and 912 would cover it, but the assert asks for 992 there too. Tightening a
	  board below its arch is a change to the assert and to what the depth macro
	  means, not a defconfig line.

	  RXV3 IS STILL A LOWER BOUND, from its current path: the frame the trap entry
	  saves plus the deepest the dispatch descends, counting the panic tail for the
	  same reason, 236 + 760 is 996, under the 1024 it takes. Terms that lower bound
	  does not count, each conditional on an entry design not yet fixed: a nested
	  switch frame, if the switcher's trap lands on the interrupted thread's kernel
	  stack rather than on the per-core handler stack, and the fault reporter, if it
	  ever runs there. An independent review derives 1056 counting some of these.

	  WHICH BOARDS PAY. Only where KICKOS_KERNEL_STACKS is 1, which is rv32imac,
	  armv7m and armv6m: the block is KICKOS_THREAD_SLOTS of this size in kernel
	  .bss, and the banner reports slot size, slot count and their product. rxv3
	  allocates nothing until its own entry conversion, which is also when its
	  red-zone reservation goes, so no board ever holds both.

config KICKOS_TLS_SIZE
	int "Per-thread TLS block"
	range 0 4096
	default 0
	help
	  Bytes of thread-local storage each thread gets, which is the .tdata plus
	  .tbss template rounded to the thread pointer's alignment. 0 until the
	  template exists, and 0 costs nothing.

	  The mechanism is NOT one register on every ISA. RISC-V and Xtensa have a
	  thread pointer (tp, THREADPTR); every ARM part in this fleet is M-profile
	  and has none, so its compiler emits a call to __aeabi_read_tp for each
	  access and the kernel has to answer it; RX has neither.

	  DERIVED FROM THE LINKER, not stated here, once a template exists: the
	  block is .tdata plus .tbss at the thread pointer's alignment, and the ABI
	  may reserve words BELOW the pointer that the block has to carry as well.
	  A number typed into a defconfig cannot track a template the linker lays
	  out.

	  AND ON RISC-V `tp` IS USER-WRITABLE, which makes it the same class of
	  hazard this milestone exists for. An unprivileged thread can put anything
	  in tp, so privileged code that reads thread-local state through the
	  incoming tp trusts a value the thread chose. The trap entry has to
	  RE-ANCHOR tp from the thread's own control block before any privileged
	  access, exactly as it validates a stack pointer rather than trusting one.

config KICKOS_MIN_STACK_SIZE
	int
	default 896 if ARCH_ARMV6M
	default 960 if ARCH_ARMV7M
	default 1024 if ARCH_RXV3
	default 1024 if ARCH_RV32IMAC
	default 896 if ARCH_LX6
	default 1024
	help
	  The floor for a caller-provided stack: the arch's deepest thread-exit
	  dispatch, measured. A stack below it passes the spawn check and then
	  overflows on exit.

	  On a backend whose trap prologue enforces a red zone below the interrupted
	  sp, this floor must also DOMINATE that red zone. A thread whose whole stack
	  is smaller cannot satisfy the prologue at all, so it does not overflow on a
	  syscall, it is refused every time. rxv3 enforces one over its whole dispatch,
	  and the two ARM backends over the window svc_trampoline spends on the thread's
	  PSP before it reaches ctx.kernel_sp. Each derives its figures in its own
	  <arch>_trap_stack.h, which is where to read them. No figure is repeated here,
	  because a copy of a measurement is a copy that goes stale.

	  RV32IMAC ENFORCES NONE, its entry having moved every U-mode frame onto the
	  thread's kernel stack, and on that arch this floor is set by PRIVILEGED
	  threads alone. An unprivileged thread runs no dispatch on its own stack any
	  more; what a privileged one runs there is unchanged, its ecall arriving with
	  mstatus.MPP=M and keeping frame and dispatch on the sp it interrupted. So the
	  relation to check is the same size against a different failure: no bound
	  exists to refuse a floor-sized privileged thread's syscall, so a floor below
	  that requirement buys an overflow instead of a refusal.
	  check_trap_redzone.sh measures it as the rv32imac SYSPRIV class and compares
	  it here; rv_trap_stack.h derives both privilege terms.

	  THE ARM BACKENDS HAVE NO SUCH SPLIT. SVC_Handler clears CONTROL.nPRIV for
	  every caller and svc_trampoline transfers on a PSP write rather than on a
	  cause branch, so a privileged thread's syscall runs on its kernel block
	  exactly as an unprivileged one's does and neither spends its own stack on the
	  dispatch. What remains there is the trampoline's transfer window, which is
	  the same for both.

	  Two things check the relation, and they are not the same check.
	  check_trap_redzone.sh compares this floor against every class that spends a
	  thread stack, per board, on the presets it is registered for. Each arch
	  backend ALSO static_asserts it, on every build of every board, and on the two
	  ARM backends that assertion is the stricter one: it adds the exception frame
	  entry stacks ABOVE the pointer the guard validates, which the gate does not
	  model and which a floor-sized thread pays before the guard ever runs. On
	  rv32imac the two agree on one figure, the privileged requirement above, and
	  the reason to keep both is coverage rather than strictness: the gate runs on
	  the presets it is registered for, the assert on every image of every board.

endmenu

# --- Console and telemetry --------------------------------------------------

menu "Console and telemetry"

choice
	prompt "Kernel console backend"
	default CONSOLE_CHIP

config CONSOLE_NONE
	bool "none"

config CONSOLE_CHIP
	bool "chip native transport"

config CONSOLE_RTT
	bool "SEGGER RTT"

config CONSOLE_BOTH
	bool "chip + RTT"

endchoice

# The RTT console transport is a plain RAM ring (lib/rtt.cc reads no clock); telemetry is
# the arm that needs arch_trace_now, and says so. Whether RTT can DELIVER depends on an
# attached debug probe, which is a fact about the rig rather than the part.

config KICKOS_CONSOLE
	string
	default "none" if CONSOLE_NONE
	default "chip" if CONSOLE_CHIP
	default "rtt" if CONSOLE_RTT
	default "both" if CONSOLE_BOTH

choice
	prompt "Telemetry transport"
	default TELEMETRY_OFF

config TELEMETRY_OFF
	bool "off"

config TELEMETRY_RTT
	bool "RTT channel 1"
	depends on HAS_TRACE_CLOCK && (CONSOLE_RTT || CONSOLE_BOTH)

endchoice

config KICKOS_TELEMETRY
	string
	default "rtt" if TELEMETRY_RTT
	default "off"

config KICKOS_RTT_CH1_SIZE
	int "RTT channel-1 ring bytes"
	depends on CONSOLE_RTT || CONSOLE_BOTH
	range 256 65536
	default 4096
	help
	  A whole run has to fit, so a long trace raises it. The default matches the
	  rtt.cc fallback. It sizes up1_buf, which the RTT CONSOLE links.

endmenu

# --- Debug and test ---------------------------------------------------------

menu "Debug and test"

config KICKOS_DEBUG
	bool "Internal-consistency guards"
	default n

config KICKOS_ENABLE_SELFTEST
	bool "Test-only self-test syscalls"
	default n

config KICKOS_SHUTDOWN_TO_BOOTLOADER
	bool "Terminating images reboot into the chip bootloader"
	depends on KICKOS_ENABLE_SELFTEST
	default n
	help
	  arch_reboot is compiled out of a production image, so without the self-test
	  syscalls nothing defines the symbol.

config KICKOS_BENCH
	bool "Cycle-accurate context-switch microbench"
	default n
	help
	  Brackets the switch body with the core's own cycle counter. That counter is
	  not arch_trace_now, so this knob does not answer to HAS_TRACE_CLOCK; the
	  brackets live in each switch.S that carries them.

config SCHED_PERIODIC_TICK
	bool "Force a classic periodic scheduler tick"
	default n

config KICKOS_PANIC_DUMP
	int "CPU-context dump on a fault (0/1)"
	default 1
	range 0 1
	help
	  Off keeps the fault banner and drops the register dump under it. Five
	  tests read a named register out of that dump and fail by name when it is
	  missing, so a board turning this off de-registers nothing and reports.

config KICKOS_DIAG_TERSE
	int "Diagnostic messages as short codes (0/1)"
	default 0
	range 0 1
	help
	  Trades the kernel's prose for the short column of include/kickos/diag.h
	  and reduces an assert to its file and line. Fault banners are unchanged in
	  either posture, so panic detection is unaffected; the prose a test script
	  matches BELOW a banner is not, which is why this is a board's choice and the
	  default is the full text.

endmenu
