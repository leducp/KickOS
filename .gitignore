# Build trees
/build/
/build-*/
/out/
/install/
cmake-build-*/

# Conan's GTest generator output, for the host unit layer. Kept in the project rather than under
# /var/tmp: a missing generator turns every unit test OFF and the sim suite still reports 100%,
# so losing it to a tmp sweep is a silent loss of most of the corpus.
/kickos-conan/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
*.cmake.stamp

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store

# Compiler / image output
*.o
*.a
*.elf
*.bin
*.hex
*.uf2
*.map
compile_commands.json

# session-local scratch (capture logs, tooling)
.session/

# local operational context (paths, rig, gotchas)
/CONTEXT.local.md

# agent worktrees and assistant state
**/.claude/

# Python bytecode from the telemetry checkers
__pycache__/
*.pyc

# ctest writes these into the source dir when it runs from the repo root.
/Testing/
