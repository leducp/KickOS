{
  "version": 6,
  "configurePresets": [
    {
      "name": "x86-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchain-x86_64-uefi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KICKOS_CONFIG_VARIANT": "base"
      }
    },
    {
      "name": "qemu-x86_64",
      "displayName": "QEMU q35 (ICH9) / x86_64, UEFI handover",
      "inherits": "x86-base",
      "binaryDir": "${sourceDir}/build/qemu-x86_64",
      "cacheVariables": { "KICKOS_BOARD": "qemu-x86_64" }
    },
    {
      "name": "qemu-x86_64-smp2",
      "displayName": "QEMU q35 / x86_64, two-core shared kernel",
      "inherits": "qemu-x86_64",
      "binaryDir": "${sourceDir}/build/qemu-x86_64-smp2",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "smp2" }
    },
    {
      "name": "qemu-x86_64-smp4",
      "displayName": "QEMU q35 / x86_64, four-core shared kernel",
      "inherits": "qemu-x86_64",
      "binaryDir": "${sourceDir}/build/qemu-x86_64-smp4",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "smp4" }
    },
    {
      "name": "qemu-x86_64-smp8",
      "displayName": "QEMU q35 / x86_64, eight-core shared kernel",
      "inherits": "qemu-x86_64",
      "binaryDir": "${sourceDir}/build/qemu-x86_64-smp8",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "smp8" }
    },
    {
      "name": "qemu-x86_64-smp12",
      "displayName": "QEMU q35 / x86_64, twelve-core shared kernel",
      "inherits": "qemu-x86_64",
      "binaryDir": "${sourceDir}/build/qemu-x86_64-smp12",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "smp12" }
    },
    {
      "name": "qemu-x86_64-bench",
      "displayName": "QEMU q35 (ICH9) / x86_64, UEFI handover + KICKOS_BENCH - context-switch microbench",
      "inherits": "qemu-x86_64",
      "binaryDir": "${sourceDir}/build/qemu-x86_64-bench",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "bench" }
    }
  ],
  "buildPresets": [
    { "name": "qemu-x86_64", "configurePreset": "qemu-x86_64" },
    { "name": "qemu-x86_64-bench", "configurePreset": "qemu-x86_64-bench" },
    { "name": "qemu-x86_64-smp2", "configurePreset": "qemu-x86_64-smp2" },
    { "name": "qemu-x86_64-smp4", "configurePreset": "qemu-x86_64-smp4" },
    { "name": "qemu-x86_64-smp8", "configurePreset": "qemu-x86_64-smp8" },
    { "name": "qemu-x86_64-smp12", "configurePreset": "qemu-x86_64-smp12" }
  ],
  "testPresets": [
    { "name": "qemu-x86_64", "configurePreset": "qemu-x86_64", "output": { "outputOnFailure": true } },
    { "name": "qemu-x86_64-bench", "configurePreset": "qemu-x86_64-bench", "output": { "outputOnFailure": true } },
    { "name": "qemu-x86_64-smp2", "configurePreset": "qemu-x86_64-smp2", "output": { "outputOnFailure": true } },
    { "name": "qemu-x86_64-smp4", "configurePreset": "qemu-x86_64-smp4", "output": { "outputOnFailure": true } },
    { "name": "qemu-x86_64-smp8", "configurePreset": "qemu-x86_64-smp8", "output": { "outputOnFailure": true } },
    { "name": "qemu-x86_64-smp12", "configurePreset": "qemu-x86_64-smp12", "output": { "outputOnFailure": true } }
  ]
}
