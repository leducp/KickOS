{
  "version": 6,
  "configurePresets": [
    {
      "name": "rx72m",
      "displayName": "Renesas RX72M (RXv3)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rx72m",
      "toolchainFile": "${sourceDir}/cmake/toolchain-rx-elf.cmake",
      "cacheVariables": {
        "KICKOS_BOARD": "rx72m",
        "KICKOS_CONFIG_VARIANT": "base",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "rx72m-st",
      "displayName": "Renesas RX72M (RXv3) + selftest (full IRQ suite)",
      "inherits": "rx72m",
      "binaryDir": "${sourceDir}/build/rx72m-st",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "st" }
    },
    {
      "name": "rx72m-flat",
      "displayName": "Renesas RX72M with no RX-MPU enforcement",
      "inherits": "rx72m",
      "binaryDir": "${sourceDir}/build/rx72m-flat",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "flat" }
    }
  ],
  "buildPresets": [
    { "name": "rx72m", "configurePreset": "rx72m" },
    { "name": "rx72m-st", "configurePreset": "rx72m-st" },
    { "name": "rx72m-flat", "configurePreset": "rx72m-flat" }
  ]
}
