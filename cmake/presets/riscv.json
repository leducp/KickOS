{
  "version": 6,
  "configurePresets": [
    {
      "name": "riscv-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchain-riscv-none-elf.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KICKOS_CONFIG_VARIANT": "base"
      }
    },
    {
      "name": "qemu-riscv",
      "displayName": "QEMU virt (RISC-V RV32IMAC, M-mode) - runnable [first RISC-V ISA]",
      "inherits": "riscv-base",
      "binaryDir": "${sourceDir}/build/qemu-riscv",
      "cacheVariables": { "KICKOS_BOARD": "qemu-riscv" }
    },
    {
      "name": "qemu-riscv-flat",
      "displayName": "QEMU virt (RISC-V) with no PMP enforcement - runnable",
      "inherits": "qemu-riscv",
      "binaryDir": "${sourceDir}/build/qemu-riscv-flat",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "flat" }
    },
    {
      "name": "qemu-riscv-bench",
      "displayName": "QEMU virt (RISC-V) + KICKOS_BENCH - context-switch microbench",
      "inherits": "qemu-riscv",
      "binaryDir": "${sourceDir}/build/qemu-riscv-bench",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "bench" }
    },
    {
      "name": "riscv64-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchain-riscv-none-elf.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KICKOS_CONFIG_VARIANT": "base"
      }
    },
    {
      "name": "qemu-riscv64",
      "displayName": "QEMU virt (RISC-V RV64IMAC) [second translating backend]",
      "inherits": "riscv64-base",
      "binaryDir": "${sourceDir}/build/qemu-riscv64",
      "cacheVariables": { "KICKOS_BOARD": "qemu-riscv64" }
    },
    {
      "name": "qemu-riscv64-sv48",
      "displayName": "QEMU virt (RISC-V RV64IMAC) with four translation levels",
      "inherits": "qemu-riscv64",
      "binaryDir": "${sourceDir}/build/qemu-riscv64-sv48",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "sv48" }
    },
    {
      "name": "qemu-riscv64-smp",
      "displayName": "QEMU virt (RISC-V RV64IMAC) with four harts under one kernel",
      "inherits": "qemu-riscv64",
      "binaryDir": "${sourceDir}/build/qemu-riscv64-smp",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "smp" }
    },
    {
      "name": "esp32c6-wroom",
      "displayName": "ESP32-C6-WROOM-1 (RISC-V RV32IMAC)",
      "inherits": "riscv-base",
      "binaryDir": "${sourceDir}/build/esp32c6-wroom",
      "cacheVariables": { "KICKOS_BOARD": "esp32c6-wroom" }
    },
    {
      "name": "esp32c6-wroom-st",
      "displayName": "ESP32-C6-WROOM-1 (RISC-V RV32IMAC) + selftest (full IRQ suite)",
      "inherits": "esp32c6-wroom",
      "binaryDir": "${sourceDir}/build/esp32c6-wroom-st",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "st" }
    },
    {
      "name": "esp32c6-wroom-flat",
      "displayName": "ESP32-C6-WROOM-1 with no PMP enforcement",
      "inherits": "esp32c6-wroom",
      "binaryDir": "${sourceDir}/build/esp32c6-wroom-flat",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "flat" }
    },
    {
      "name": "esp32c6-wroom-bench",
      "displayName": "ESP32-C6-WROOM-1 + KICKOS_BENCH - the call/reply phase decomposition, enforcing",
      "inherits": "esp32c6-wroom",
      "binaryDir": "${sourceDir}/build/esp32c6-wroom-bench",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "bench" }
    }
  ],
  "buildPresets": [
    { "name": "qemu-riscv",    "configurePreset": "qemu-riscv" },
    { "name": "qemu-riscv-flat", "configurePreset": "qemu-riscv-flat" },
    { "name": "qemu-riscv-bench", "configurePreset": "qemu-riscv-bench" },
    { "name": "qemu-riscv64", "configurePreset": "qemu-riscv64" },
    { "name": "qemu-riscv64-sv48", "configurePreset": "qemu-riscv64-sv48" },
    { "name": "qemu-riscv64-smp", "configurePreset": "qemu-riscv64-smp" },
    { "name": "esp32c6-wroom", "configurePreset": "esp32c6-wroom" },
    { "name": "esp32c6-wroom-st", "configurePreset": "esp32c6-wroom-st" },
    { "name": "esp32c6-wroom-flat", "configurePreset": "esp32c6-wroom-flat" },
    { "name": "esp32c6-wroom-bench", "configurePreset": "esp32c6-wroom-bench" }
  ],
  "testPresets": [
    { "name": "qemu-riscv", "configurePreset": "qemu-riscv", "output": { "outputOnFailure": true } },
    { "name": "qemu-riscv-flat", "configurePreset": "qemu-riscv-flat", "output": { "outputOnFailure": true } },
    { "name": "qemu-riscv64", "configurePreset": "qemu-riscv64", "output": { "outputOnFailure": true } },
    { "name": "qemu-riscv64-sv48", "configurePreset": "qemu-riscv64-sv48", "output": { "outputOnFailure": true } },
    { "name": "qemu-riscv64-smp", "configurePreset": "qemu-riscv64-smp", "output": { "outputOnFailure": true } }
  ]
}
