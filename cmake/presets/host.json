{
  "version": 6,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "sim",
      "displayName": "Host x86-64 sim",
      "inherits": "kickos-base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-host.cmake",
      "cacheVariables": { "KICKOS_BOARD": "sim" }
    },
    {
      "name": "sim-telem",
      "displayName": "Host sim + telemetry (RTT ch1) - runs the telemetry CI gates",
      "inherits": "sim",
      "cacheVariables": { "KICKOS_CONFIG_VARIANT": "telem" }
    }
  ],
  "buildPresets": [
    { "name": "sim",       "configurePreset": "sim" },
    { "name": "sim-telem", "configurePreset": "sim-telem" }
  ],
  "testPresets": [
    { "name": "sim",       "configurePreset": "sim",       "output": { "outputOnFailure": true } },
    { "name": "sim-telem", "configurePreset": "sim-telem", "output": { "outputOnFailure": true } }
  ]
}
