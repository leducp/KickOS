{
  "version": 6,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "arm64-base",
      "hidden": true,
      "inherits": "kickos-base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-aarch64-none-elf.cmake"
    },
    {
      "name": "qemu-arm64",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1) [first 64-bit ISA]",
      "inherits": "arm64-base",
      "cacheVariables": { "KICKOS_BOARD": "qemu-arm64" }
    },
    {
      "name": "qemu-arm64-smp",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1) with four cores",
      "inherits": "qemu-arm64",
      "cacheVariables": {
        "KICKOS_CONFIG_VARIANT": "smp",
        "KICKOS_GOLDEN_COMPOSITION": "examples/composition/systems/qemu-arm64.yaml",
        "KICKOS_RESTART_WITNESS_SYSTEM": "tests/integration/composition_witness/systems/restart-qemu-arm64.yaml",
        "KICKOS_LINE_TAKER_SYSTEM": "tests/integration/composition_witness/systems/line-qemu-arm64.yaml",
        "KICKOS_DRIVER_WITNESS_SYSTEM": "tests/integration/driver_witness/systems/qemu-arm64.yaml",
        "KICKOS_CONSOLE_WITNESS_SYSTEM": "tests/integration/console_witness/systems/qemu-arm64.yaml",
        "KICKOS_DRIVER_LINE_SYSTEM": "tests/integration/driver_witness/systems/line-qemu-arm64.yaml",
        "KICKOS_TEST_DRIVERS": "ON",
        "KICKOS_WITNESS_ROOT_DEPTH": "ON"
      }
    },
    {
      "name": "qemu-arm64-smp2",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1) with two cores",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "cores", "KICKOS_CONFIG_VARIANT": "smp2" }
    },
    {
      "name": "qemu-arm64-smp12",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1) with twelve cores under GICv3",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "cores;gic", "KICKOS_CONFIG_VARIANT": "smp12" }
    },
    {
      "name": "qemu-arm64-smpiso",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), four cores with core 3 isolated",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "iso", "KICKOS_CONFIG_VARIANT": "smpiso" }
    },
    {
      "name": "qemu-arm64-gicv3",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1) with four cores under GICv3",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "gic", "KICKOS_CONFIG_VARIANT": "gicv3" }
    },
    {
      "name": "qemu-arm64-amp",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), four cores driven by one kernel core under GICv3",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "amp", "KICKOS_CONFIG_VARIANT": "amp" }
    },
    {
      "name": "qemu-arm64-amp2-n0",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), node 0 of a two-image AMP partition",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "amp", "KICKOS_CONFIG_VARIANT": "amp2", "KICKOS_AMP_NODE_ID": "0" }
    },
    {
      "name": "qemu-arm64-amp2-n1",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), node 1 of a two-image AMP partition",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "amp", "KICKOS_CONFIG_VARIANT": "amp2", "KICKOS_AMP_NODE_ID": "1" }
    },
    {
      "name": "qemu-arm64-amp3-n0",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), node 0 of a three-image AMP partition",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "amp", "KICKOS_CONFIG_VARIANT": "amp3", "KICKOS_AMP_NODE_ID": "0" }
    },
    {
      "name": "qemu-arm64-amp3-n1",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), node 1 of a three-image AMP partition",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "amp", "KICKOS_CONFIG_VARIANT": "amp3", "KICKOS_AMP_NODE_ID": "1" }
    },
    {
      "name": "qemu-arm64-amp3-n2",
      "displayName": "QEMU virt (AArch64 Cortex-A53, EL1), node 2 of a three-image AMP partition",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "amp", "KICKOS_CONFIG_VARIANT": "amp3", "KICKOS_AMP_NODE_ID": "2" }
    },
    {
      "name": "qemu-arm64-a710",
      "displayName": "QEMU virt, four Cortex-A710 cores running the A53 image: hardware PAN, later ARMv8.x protection",
      "inherits": "qemu-arm64",
      "cacheVariables": { "KICKOS_TEST_SHAPE": "cpu", "KICKOS_CONFIG_VARIANT": "a710", "KICKOS_QEMU_CPU": "cortex-a710" }
    },
    {
      "name": "imx8mp-evk",
      "displayName": "NXP i.MX 8M Plus EVK (quad Cortex-A53, GIC-500, EL3 handover)",
      "inherits": "arm64-base",
      "cacheVariables": { "KICKOS_BOARD": "imx8mp-evk" }
    }
  ],
  "buildPresets": [
    { "name": "qemu-arm64", "configurePreset": "qemu-arm64" },
    { "name": "qemu-arm64-smp", "configurePreset": "qemu-arm64-smp" },
    { "name": "qemu-arm64-smp2", "configurePreset": "qemu-arm64-smp2" },
    { "name": "qemu-arm64-smp12", "configurePreset": "qemu-arm64-smp12" },
    { "name": "qemu-arm64-smpiso", "configurePreset": "qemu-arm64-smpiso" },
    { "name": "qemu-arm64-gicv3", "configurePreset": "qemu-arm64-gicv3" },
    { "name": "qemu-arm64-amp", "configurePreset": "qemu-arm64-amp" },
    { "name": "qemu-arm64-amp2-n0", "configurePreset": "qemu-arm64-amp2-n0" },
    { "name": "qemu-arm64-amp2-n1", "configurePreset": "qemu-arm64-amp2-n1" },
    { "name": "qemu-arm64-amp3-n0", "configurePreset": "qemu-arm64-amp3-n0" },
    { "name": "qemu-arm64-amp3-n1", "configurePreset": "qemu-arm64-amp3-n1" },
    { "name": "qemu-arm64-amp3-n2", "configurePreset": "qemu-arm64-amp3-n2" },
    { "name": "qemu-arm64-a710", "configurePreset": "qemu-arm64-a710" },
    { "name": "imx8mp-evk", "configurePreset": "imx8mp-evk" }
  ],
  "testPresets": [
    { "name": "qemu-arm64", "configurePreset": "qemu-arm64", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-smp", "configurePreset": "qemu-arm64-smp", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-smp2", "configurePreset": "qemu-arm64-smp2", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-smp12", "configurePreset": "qemu-arm64-smp12", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-smpiso", "configurePreset": "qemu-arm64-smpiso", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-gicv3", "configurePreset": "qemu-arm64-gicv3", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-amp", "configurePreset": "qemu-arm64-amp", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-amp2-n0", "configurePreset": "qemu-arm64-amp2-n0", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-amp2-n1", "configurePreset": "qemu-arm64-amp2-n1", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-amp3-n0", "configurePreset": "qemu-arm64-amp3-n0", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-amp3-n1", "configurePreset": "qemu-arm64-amp3-n1", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-amp3-n2", "configurePreset": "qemu-arm64-amp3-n2", "output": { "outputOnFailure": true } },
    { "name": "qemu-arm64-a710", "configurePreset": "qemu-arm64-a710", "output": { "outputOnFailure": true } },
    { "name": "imx8mp-evk", "configurePreset": "imx8mp-evk", "output": { "outputOnFailure": true } }
  ]
}
